{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http" : "Warning"
    }
  },
  "ConnectionStrings": {
    "LeadRelay": "Server=localhost;Port=3307;User ID=root;Password=root;Database=LeadRelay"
  },
  "Urls": "http://localhost:5180",
  "WhatsApp": {
    "VerifyToken": "change_me_in_real_env",
    "AccessToken": "paste_your_cloud_api_access_token",
    "MessagesEndpoint": "https://graph.facebook.com/v20.0/<PHONE_NUMBER_ID>/messages"
  },
  "OpenAI": {
    "Enabled": true,
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1",
    "MaxOutputTokens": 400,
    "Temperature": 0.4
  },
  "Conversation": {
    "UseLlm": true,
    "MaxHistoryTurns": 8,
    "SessionTimeoutHours": 48,
    "BotEnabled": true
  },
  "AdminAuth": {
    "HeaderName": "X-Admin-Token",
    "QueryParameterName": "adminToken",
    "CookieName": "leadrelay_admin_token",
    "Token": "change_me_in_real_env"
  }
}
