    "MaxHistoryTurns": 8,
    "SessionTimeoutHours": 48,
    "BotEnabled": true
  },
  "AdminAuth": {
    "HeaderName": "X-Admin-Token",
    "QueryParameterName": "adminToken",
    "CookieName": "leadrelay_admin_token",
    "Token": ""
  },
  "OwnerPortal": {
    "SigningSecret": "",
    "SessionCookieName": "leadrelay_owner_session",
    "SessionTtlHours": 12,
    "PasswordResetTtlMinutes": 30
  }
