{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http" : "Warning"
    }
  },
  "ConnectionStrings": {
    "LeadRelay": ""
  },
  "PublicBaseUrl": "",
  "WhatsApp": {
    "VerifyToken": "",
    "AccessToken": "",
    "MessagesEndpoint": "",
    "Senders": {}
  },
  "OpenAI": {
    "Enabled": true,
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1",
