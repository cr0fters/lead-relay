@{
    Layout = "~/Views/Shared/_MarketingLayout.cshtml";
    ViewData["Title"] = "User data deletion instructions | LeadRelay";
}

<div class="doc-wrap">
    <p><a href="/" style="color:#0f766e;">Back to home</a></p>
    <h1 style="margin:0 0 8px;font-family:'Manrope',sans-serif;">User data deletion instructions</h1>
    <p class="doc-meta">Updated: February 12, 2026</p>

    <section class="doc-card">
        <p>If you want your personal data deleted from LeadRelay, follow the steps below.</p>

        <h2>How to request deletion</h2>
        <ol>
            <li>Email <a href="mailto:privacy@leadrelay.dev" style="color:#0f766e;">privacy@leadrelay.dev</a> with subject line <code style="background:#f1f5f9;padding:2px 6px;border-radius:6px;">Data deletion request</code>.</li>
            <li>Include the phone number and/or email address used in your conversation.</li>
            <li>Include the business name you contacted, if known.</li>
        </ol>

        <h2>What we do next</h2>
        <ol>
            <li>We verify the request and locate the matching records.</li>
            <li>We remove or anonymize personal data in LeadRelay systems, unless retention is legally required.</li>
            <li>We send confirmation once processing is complete.</li>
        </ol>

        <h2>Timeline</h2>
        <p>We aim to complete verified requests within 30 days.</p>

        <h2>Important notes</h2>
        <p>Some data may also exist in third-party providers (for example WhatsApp/Meta or email providers). Where applicable, we will guide you on their deletion processes as well.</p>

        <h2>Contact</h2>
        <p>Email: <a href="mailto:privacy@leadrelay.dev" style="color:#0f766e;">privacy@leadrelay.dev</a></p>
    </section>
</div>
