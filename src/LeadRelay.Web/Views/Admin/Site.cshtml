@model LeadRelay.Web.Controllers.AdminController.SiteFormModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Site configuration";
}

<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8" x-data>
    <header class="mb-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-panel sm:p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"><a class="hover:text-slate-700" href="/admin">Admin</a> / Site</p>
                <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900">Site configuration</h1>
                <p class="text-sm text-slate-600">Update how this site appears in WhatsApp flows and widget embeds.</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a class="inline-flex items-center gap-2 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" href="/admin">
                    <i data-lucide="arrow-left" class="h-4 w-4"></i>
                    <span>Back to dashboard</span>
                </a>
                <a class="inline-flex items-center gap-2 rounded-md border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100" href="/debug/whatsapp">
                    <i data-lucide="wrench" class="h-4 w-4"></i>
                    <span>Debug tool</span>
                </a>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@Model.Error</div>
    }
    <form method="post" action="@(string.IsNullOrWhiteSpace(Model.Id) ? "/admin/sites/new" : $"/admin/sites/{Model.Id}")" class="space-y-4">
        <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-panel sm:p-5">
            <h2 class="text-sm font-semibold text-slate-900">Core details</h2>
            <p class="mb-4 text-xs text-slate-500">Basic login and routing identity for this site.</p>

            <div class="grid gap-3 md:grid-cols-2">
                <div>
                    <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="Name">Site name</label>
                    <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="Name" name="Name" value="@Model.Name" placeholder="Spaces by Kelly" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="OwnerEmail">Login email</label>
                    <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="OwnerEmail" name="OwnerEmail" value="@Model.OwnerEmail" placeholder="you@example.com" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="WhatsAppNumber">WhatsApp number</label>
                    <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="WhatsAppNumber" name="WhatsAppNumber" value="@Model.WhatsAppNumber" placeholder="447000000000" />
                    <p class="mt-1 text-xs text-slate-500">Digits only, include country code.</p>
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="WhatsAppPhoneNumberId">WhatsApp phone number ID</label>
                    <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="WhatsAppPhoneNumberId" name="WhatsAppPhoneNumberId" value="@Model.WhatsAppPhoneNumberId" placeholder="123456789012345" />
                    <p class="mt-1 text-xs text-slate-500">Required for tenant-aware inbound and outbound routing.</p>
                </div>
                <div class="md:col-span-2">
                    <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="AllowedDomains">Allowed domains</label>
                    <textarea class="min-h-[112px] w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="AllowedDomains" name="AllowedDomains" placeholder="example.com&#10;app.example.com">@Model.AllowedDomains</textarea>
                    <p class="mt-1 text-xs text-slate-500">One per line or comma-separated. Empty means allow any domain.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.OwnerLoginPath))
            {
                <div class="mt-4 rounded-lg border border-indigo-200 bg-indigo-50 p-3">
                    <label class="mb-1.5 block text-sm font-semibold text-indigo-700" for="OwnerLoginPath">Workspace login link</label>
                    <input class="w-full rounded-lg border border-indigo-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none" id="OwnerLoginPath" value="@Model.OwnerLoginPath" readonly />
                    <p class="mt-1 text-xs text-indigo-700">Share this so users can sign in or reset their password.</p>
                </div>
            }

        </section>

        <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-panel sm:p-5">
            <h2 class="text-sm font-semibold text-slate-900">Conversation prompts</h2>
            <p class="mb-4 text-xs text-slate-500">Context shown to AI before a conversation starts.</p>

            <div class="space-y-3">
                <div>
                    <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="BusinessSummary">Business summary</label>
                    <textarea class="min-h-[120px] w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="BusinessSummary" name="BusinessSummary" placeholder="Short summary for AI/system prompts.">@Model.BusinessSummary</textarea>
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="IntroMessage">Intro message</label>
                    <textarea class="min-h-[120px] w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="IntroMessage" name="IntroMessage" placeholder="Hey, thanks for reaching out!">@Model.IntroMessage</textarea>
                </div>
            </div>
        </section>

        <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-panel sm:p-5">
            <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                <div>
                    <h2 class="text-sm font-semibold text-slate-900">Project fields</h2>
                    <p class="text-xs text-slate-500">Define fields captured in lead conversations. Field IDs are generated automatically.</p>
                </div>
                <button class="inline-flex items-center gap-2 rounded-md border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100" type="button" id="add-field">
                    <i data-lucide="plus" class="h-4 w-4"></i>
                    <span>Add field</span>
                </button>
            </div>

            <div class="space-y-2" id="fields"></div>
            <textarea id="FieldsJson" name="FieldsJson" class="hidden">@Model.FieldsJson</textarea>
        </section>

        <div class="flex flex-wrap gap-2">
            <button class="inline-flex items-center gap-2 rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-700" type="submit">
                <i data-lucide="save" class="h-4 w-4"></i>
                <span>Save site</span>
            </button>
            <a class="inline-flex items-center gap-2 rounded-md border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" href="/admin">Cancel</a>
        </div>
    </form>
</div>

<template id="field-row-template">
    <article class="field-card rounded-xl border border-slate-200 bg-slate-50 p-3">
        <input type="hidden" data-field="id" />

        <div data-view class="flex items-start justify-between gap-3">
            <div>
                <p class="text-sm font-semibold text-slate-900" data-display="name">Untitled field</p>
                <p class="mt-1 whitespace-pre-wrap text-sm text-slate-600" data-display="description">No description yet.</p>
            </div>
            <div class="flex shrink-0 gap-2">
                <button class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100" type="button" data-edit>Edit</button>
                <button class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-100" type="button" data-remove>Remove</button>
            </div>
        </div>

        <div data-edit-panel class="hidden space-y-2">
            <div>
                <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.1em] text-slate-500">Name</label>
                <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" type="text" data-field="name" placeholder="Project overview" />
            </div>
            <div>
                <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.1em] text-slate-500">Description</label>
                <textarea class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" rows="3" data-field="description" placeholder="Optional hint for this field"></textarea>
            </div>
            <div class="flex justify-end gap-2">
                <button class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-100" type="button" data-remove>Remove</button>
                <button class="rounded-lg border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 transition hover:bg-sky-100" type="button" data-done>Done</button>
            </div>
        </div>
    </article>
</template>

<script>
    const fieldsContainer = document.getElementById("fields");
    const template = document.getElementById("field-row-template");
    const fieldsJson = document.getElementById("FieldsJson");

    function parseFields(value) {
        if (!value || !value.trim()) return [];
        try {
            return JSON.parse(value);
        } catch {
            return [];
        }
    }

    function slugify(value) {
        return (value || "")
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9\\s_.-]/g, "")
            .replace(/[\\s.-]+/g, "_")
            .replace(/^_+|_+$/g, "");
    }

    function renderRowPreview(row) {
        const name = row.querySelector('[data-field="name"]').value.trim();
        const description = row.querySelector('[data-field="description"]').value.trim();
        row.querySelector('[data-display="name"]').textContent = name || "Untitled field";
        row.querySelector('[data-display="description"]').textContent = description || "No description yet.";
    }

    function syncRowId(row) {
        if (row.dataset.lockedId === "true") return;
        const name = row.querySelector('[data-field="name"]').value.trim();
        row.querySelector('[data-field="id"]').value = slugify(name);
    }

    function setEditing(row, editing) {
        row.querySelector('[data-view]').classList.toggle("hidden", editing);
        row.querySelector('[data-edit-panel]').classList.toggle("hidden", !editing);
    }

    function createRow(field, container) {
        const fragment = template.content.cloneNode(true);
        const row = fragment.querySelector(".field-card");
        row.querySelector('[data-field="id"]').value = field.id || "";
        row.querySelector('[data-field="name"]').value = field.name || "";
        row.querySelector('[data-field="description"]').value = field.description || "";
        row.dataset.lockedId = field.id && field.id.trim() ? "true" : "false";

        row.querySelectorAll('[data-remove]').forEach((button) => {
            button.addEventListener("click", () => row.remove());
        });
        row.querySelector('[data-edit]').addEventListener("click", () => setEditing(row, true));
        row.querySelector('[data-done]').addEventListener("click", () => {
            syncRowId(row);
            renderRowPreview(row);
            setEditing(row, false);
        });
        row.querySelector('[data-field="name"]').addEventListener("input", () => syncRowId(row));
        renderRowPreview(row);
        setEditing(row, !(field.id && field.id.trim()));
        container.appendChild(row);
        if (window.refreshLucideIcons) {
            window.refreshLucideIcons();
        }
    }

    function bootstrap(container, jsonField) {
        const fields = parseFields(jsonField.value);
        if (fields.length === 0) {
            createRow({ id: "", name: "", description: "" }, container);
            return;
        }

        fields.forEach(field => createRow({
            id: field.id || field.key,
            name: field.name || field.key,
            description: field.description || field.prompt
        }, container));
    }

    function serialize(container, jsonField) {
        const items = [];
        container.querySelectorAll('.field-card').forEach((row) => {
            if (!row) return;

            const name = row.querySelector('[data-field="name"]').value.trim();
            const description = row.querySelector('[data-field="description"]').value.trim();
            const idInput = row.querySelector('[data-field="id"]');
            if (!idInput.value.trim()) {
                idInput.value = slugify(name);
            }
            const id = idInput.value.trim();
            if (!id && !name && !description) return;
            items.push({ id, name, description });
        });

        jsonField.value = JSON.stringify(items, null, 2);
    }

    document.getElementById("add-field").addEventListener("click", () => {
        createRow({ id: "", name: "", description: "" }, fieldsContainer);
    });

    const form = document.querySelector("form");
    form.addEventListener("submit", () => {
        serialize(fieldsContainer, fieldsJson);
    });

    bootstrap(fieldsContainer, fieldsJson);
</script>
