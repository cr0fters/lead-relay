@model LeadRelay.Web.Controllers.AdminController.AdminDashboardModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Admin dashboard";
}

<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8" x-data>
    <header class="mb-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-panel sm:p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">LeadRelay admin</p>
                <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900">Admin dashboard</h1>
                <p class="text-sm text-slate-600">Manage site configuration, onboarding, and debugging tools.</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a class="inline-flex items-center gap-2 rounded-md border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 transition hover:bg-sky-100" href="/admin/sites/new">
                    <i data-lucide="plus-circle" class="h-4 w-4"></i>
                    <span>Create new site</span>
                </a>
                <a class="inline-flex items-center gap-2 rounded-md border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100" href="/debug/whatsapp">
                    <i data-lucide="wrench" class="h-4 w-4"></i>
                    <span>Open debug tool</span>
                </a>
            </div>
        </div>
    </header>

    <section class="mb-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Total sites</p>
            <p class="mt-1 font-display text-3xl font-semibold text-slate-900">@Model.Sites.Count</p>
        </article>
        <article class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-emerald-700">Configuration</p>
            <p class="mt-1 text-sm text-emerald-800">Keep owner contacts, WhatsApp routing, and domains aligned per site.</p>
        </article>
        <article class="rounded-xl border border-indigo-200 bg-indigo-50 p-4 shadow-panel sm:col-span-2 xl:col-span-1">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-700">Tools</p>
            <p class="mt-1 text-sm text-indigo-800">Use the debug console to validate WhatsApp conversation behavior quickly.</p>
        </article>
    </section>

    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-panel">
        <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
            <h2 class="text-sm font-semibold text-slate-900">Sites</h2>
            <p class="text-xs text-slate-500">Select a site to edit owner access and integration settings.</p>
        </div>

        @if (Model.Sites.Count == 0)
        {
            <div class="px-4 py-6 text-sm text-slate-500">No sites yet. Create your first site to get started.</div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var site in Model.Sites)
                {
                    <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                        <div>
                            <p class="text-sm font-semibold text-slate-900">@site.Name</p>
                            <p class="text-sm text-slate-600">@site.OwnerEmail</p>
                        </div>
                        <a class="inline-flex items-center gap-2 rounded-md border border-sky-200 bg-sky-50 px-3 py-1.5 text-sm font-semibold text-sky-700 transition hover:bg-sky-100" href="/admin/sites/@site.Id">
                            <i data-lucide="arrow-up-right" class="h-4 w-4"></i>
                            <span>Edit site</span>
                        </a>
                    </div>
                }
            </div>
        }
    </section>
</div>
