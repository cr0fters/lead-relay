@model LeadRelay.Web.Controllers.AdminController.AdminDashboardModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Admin dashboard";
}

<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8" x-data>
    <header class="mb-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-panel sm:p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">LeadRelay admin</p>
                <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900">Admin dashboard</h1>
                <p class="text-sm text-slate-600">Manage site configuration, onboarding, and debugging tools.</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a class="inline-flex items-center gap-2 rounded-md border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 transition hover:bg-sky-100" href="/admin/sites/new">
                    <i data-lucide="plus-circle" class="h-4 w-4"></i>
                    <span>Create new site</span>
                </a>
                <a class="inline-flex items-center gap-2 rounded-md border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100" href="/debug/whatsapp">
                    <i data-lucide="wrench" class="h-4 w-4"></i>
                    <span>Open debug tool</span>
                </a>
            </div>
        </div>
    </header>

    <section class="mb-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Total sites</p>
            <p class="mt-1 font-display text-3xl font-semibold text-slate-900">@Model.Sites.Count</p>
        </article>
        <article class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-emerald-700">Configuration</p>
            <p class="mt-1 text-sm text-emerald-800">Keep login contacts, WhatsApp routing, and domains aligned per site.</p>
        </article>
        <article class="rounded-xl border border-indigo-200 bg-indigo-50 p-4 shadow-panel sm:col-span-2 xl:col-span-1">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-700">Tools</p>
            <p class="mt-1 text-sm text-indigo-800">Use the debug console to validate WhatsApp conversation behavior quickly.</p>
        </article>
    </section>

    <section class="mb-4 rounded-xl border border-slate-200 bg-white p-4 shadow-panel sm:p-5">
        <div class="mb-3">
            <h2 class="text-sm font-semibold text-slate-900">Global email test</h2>
            <p class="text-xs text-slate-500">Validate Postmark credentials for LeadRelay transactional emails without editing app configuration.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.EmailTest.Error))
        {
            <div class="mb-3 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700">@Model.EmailTest.Error</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.EmailTest.Success))
        {
            <div class="mb-3 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700">@Model.EmailTest.Success</div>
        }

        <form method="post" action="/admin/tools/email-test" class="grid gap-3 lg:grid-cols-2">
            @Html.AntiForgeryToken()
            @Html.AntiForgeryToken()
            <div>
                <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="ApiBaseUrl">API base URL</label>
                <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="ApiBaseUrl" name="ApiBaseUrl" value="@Model.EmailTest.ApiBaseUrl" placeholder="https://api.postmarkapp.com/" />
            </div>
            <div>
                <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="ServerToken">Server token</label>
                <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="ServerToken" name="ServerToken" value="@Model.EmailTest.ServerToken" autocomplete="off" />
            </div>
            <div>
                <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="FromEmail">From email</label>
                <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="FromEmail" name="FromEmail" value="@Model.EmailTest.FromEmail" placeholder="noreply@yourdomain.com" />
            </div>
            <div>
                <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="FromName">From name</label>
                <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="FromName" name="FromName" value="@Model.EmailTest.FromName" placeholder="LeadRelay" />
            </div>
            <div>
                <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="ToEmail">To email</label>
                <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="ToEmail" name="ToEmail" value="@Model.EmailTest.ToEmail" placeholder="you@example.com" />
            </div>
            <div>
                <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="Subject">Subject</label>
                <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="Subject" name="Subject" value="@Model.EmailTest.Subject" />
            </div>
            <div class="lg:col-span-2">
                <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="BodyText">Body</label>
                <textarea class="min-h-[110px] w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="BodyText" name="BodyText">@Model.EmailTest.BodyText</textarea>
            </div>
            <div class="lg:col-span-2">
                <button class="inline-flex items-center gap-2 rounded-md border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100" type="submit">
                    <i data-lucide="send" class="h-4 w-4"></i>
                    <span>Send test email</span>
                </button>
            </div>
        </form>
    </section>

    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-panel">
        <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
            <h2 class="text-sm font-semibold text-slate-900">Sites</h2>
            <p class="text-xs text-slate-500">Select a site to edit workspace access and integration settings.</p>
        </div>

        @if (Model.Sites.Count == 0)
        {
            <div class="px-4 py-6 text-sm text-slate-500">No sites yet. Create your first site to get started.</div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var site in Model.Sites)
                {
                    <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                        <div>
                            <p class="text-sm font-semibold text-slate-900">@site.Name</p>
                            <p class="text-sm text-slate-600">@site.OwnerEmail</p>
                        </div>
                        <a class="inline-flex items-center gap-2 rounded-md border border-sky-200 bg-sky-50 px-3 py-1.5 text-sm font-semibold text-sky-700 transition hover:bg-sky-100" href="/admin/sites/@site.Id">
                            <i data-lucide="arrow-up-right" class="h-4 w-4"></i>
                            <span>Edit site</span>
                        </a>
                    </div>
                }
            </div>
        }
    </section>
</div>
