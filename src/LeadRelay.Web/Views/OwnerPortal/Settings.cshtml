@using System.Text.Json
@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerSiteSettingsModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Settings";
    var initialRowsJson = JsonSerializer.Serialize(Model.Fields.Select(x => new
    {
        id = x.Id ?? "",
        name = x.Name ?? "",
        description = x.Description ?? ""
    }));
}

<div class="w-full px-4 py-5 sm:px-6 lg:px-8" x-data='fieldEditor(@Html.Raw(initialRowsJson))' x-init="$nextTick(() => window.refreshLucideIcons && window.refreshLucideIcons())">
    <header class="mb-3 rounded-lg border border-slate-200 bg-white p-3 shadow-panel">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"><a class="hover:text-slate-700" href="/owner">Leads</a> / Settings</p>
            <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900">Project field definitions</h1>
            <p class="text-sm text-slate-600">@Model.SiteName</p>
        </div>
    </header>

    <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-panel">
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="mb-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@Model.Error</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Success))
        {
            <div
                x-data="{ show: true }"
                x-show="show"
                x-transition:enter="transition ease-out duration-250"
                x-transition:enter-start="opacity-0 translate-y-1"
                x-transition:enter-end="opacity-100 translate-y-0"
                x-transition:leave="transition ease-in duration-300"
                x-transition:leave-start="opacity-100 translate-y-0"
                x-transition:leave-end="opacity-0 translate-y-1"
                x-init="setTimeout(() => show = false, 3200)"
                class="fixed right-4 top-[4.5rem] z-50 w-[min(24rem,calc(100vw-2rem))] rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 shadow-lg">
                <div class="flex items-start gap-2">
                    <i data-lucide="check-circle" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-700"></i>
                    <p class="font-medium">@Model.Success</p>
                </div>
            </div>
        }

        <form method="post" action="/owner/settings/fields" class="space-y-3">
            @Html.AntiForgeryToken()

            <template x-for="(row, index) in rows" :key="index">
                <article class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <input type="hidden" :name="`fields[${index}].Id`" x-model="row.id" />

                    <div x-show="!row.editing" x-cloak class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-sm font-semibold text-slate-900" x-text="row.name || 'Untitled field'"></p>
                            <p class="mt-1 whitespace-pre-wrap text-sm text-slate-600" x-text="row.description || 'No description yet.'"></p>
                        </div>
                        <div class="flex shrink-0 gap-2">
                            <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100" @@click="editRow(index)">Edit</button>
                            <button type="button" class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-100" @@click="removeRow(index)">Remove</button>
                        </div>
                    </div>

                    <div x-show="row.editing" x-cloak class="space-y-2">
                        <div>
                            <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.1em] text-slate-500">Name</label>
                            <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" x-model="row.name" :name="`fields[${index}].Name`" placeholder="Project overview" @@input="syncRowId(index)" />
                        </div>
                        <div>
                            <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.1em] text-slate-500">Description</label>
                            <textarea class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" x-model="row.description" :name="`fields[${index}].Description`" rows="3" placeholder="Optional guidance prompt"></textarea>
                        </div>
                        <div class="flex justify-end gap-2">
                            <button type="button" class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-100" @@click="removeRow(index)">Remove</button>
                            <button type="button" class="rounded-lg border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" @@click="finishEdit(index)">Done</button>
                        </div>
                    </div>

                    <template x-if="!row.editing">
                        <input type="hidden" :name="`fields[${index}].Name`" :value="row.name" />
                    </template>
                    <template x-if="!row.editing">
                        <input type="hidden" :name="`fields[${index}].Description`" :value="row.description" />
                    </template>
                </article>
            </template>

            <div class="flex flex-wrap gap-2">
                <button class="inline-flex items-center gap-2 rounded-md border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100" type="button" @@click="addRow()">
                    <i data-lucide="plus" class="h-4 w-4"></i>
                    <span>Add field</span>
                </button>
                <button class="inline-flex items-center gap-2 rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-700" type="submit">
                    <i data-lucide="save" class="h-4 w-4"></i>
                    <span>Save field definitions</span>
                </button>
            </div>
        </form>
    </section>
</div>

@section HeadScripts {
<script>
    function fieldEditor(initialRows) {
        return {
            rows: initialRows && initialRows.length
                ? initialRows.map(row => ({ ...row, editing: false }))
                : [{ id: "", name: "", description: "", editing: true }],
            slugify(value) {
                return (value || "")
                    .toLowerCase()
                    .trim()
                    .replace(/[^a-z0-9\s_.-]/g, "")
                    .replace(/[\s.-]+/g, "_")
                    .replace(/^_+|_+$/g, "");
            },
            syncRowId(index) {
                if (!this.rows[index]) return;
                if ((this.rows[index].id || "").trim().length > 0) return;
                this.rows[index].id = this.slugify(this.rows[index].name);
            },
            editRow(index) {
                this.rows[index].editing = true;
            },
            finishEdit(index) {
                this.syncRowId(index);
                this.rows[index].editing = false;
            },
            addRow() {
                this.rows.push({ id: "", name: "", description: "", editing: true });
                this.$nextTick(() => window.refreshLucideIcons && window.refreshLucideIcons());
            },
            removeRow(index) {
                this.rows.splice(index, 1);
                if (this.rows.length === 0) this.addRow();
                this.$nextTick(() => window.refreshLucideIcons && window.refreshLucideIcons());
            }
        };
    }
</script>
}
