@using System.Text.Json
@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerSiteSettingsModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Settings";
    var initialRowsJson = JsonSerializer.Serialize(Model.Fields.Select(x => new
    {
        id = x.Id ?? "",
        name = x.Name ?? "",
        description = x.Description ?? ""
    }));
}

<div class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 lg:px-8" x-data='fieldEditor(@Html.Raw(initialRowsJson))' x-init="$nextTick(() => window.refreshLucideIcons && window.refreshLucideIcons())">
    <header class="mb-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-panel">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"><a class="hover:text-slate-700" href="/owner">Leads</a> / Settings</p>
                <h1 class="mt-1 font-display text-3xl font-semibold tracking-tight text-slate-900">Business and lead setup</h1>
                <p class="mt-2 text-sm text-slate-600">Control what customers see and what LeadRelay asks them.</p>
            </div>
            <a href="/owner/onboarding" class="inline-flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100">
                <i data-lucide="message-circle" class="h-4 w-4"></i>
                WhatsApp setup
            </a>
        </div>
    </header>

    <div class="mb-4">
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="mb-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@Model.Error</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Success))
        {
            <div
                x-data="{ show: true }"
                x-show="show"
                x-transition:enter="transition ease-out duration-250"
                x-transition:enter-start="opacity-0 translate-y-1"
                x-transition:enter-end="opacity-100 translate-y-0"
                x-transition:leave="transition ease-in duration-300"
                x-transition:leave-start="opacity-100 translate-y-0"
                x-transition:leave-end="opacity-0 translate-y-1"
                x-init="setTimeout(() => show = false, 3200)"
                class="fixed right-4 top-[4.5rem] z-50 w-[min(24rem,calc(100vw-2rem))] rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 shadow-lg">
                <div class="flex items-start gap-2">
                    <i data-lucide="check-circle" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-700"></i>
                    <p class="font-medium">@Model.Success</p>
                </div>
            </div>
        }

    </div>

    <div class="grid gap-4 lg:grid-cols-[1fr_1fr]">
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-panel">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-emerald-700">Business profile</p>
                <h2 class="mt-1 font-display text-xl font-semibold text-slate-900">Customer-facing details</h2>
                <p class="mt-1 text-sm text-slate-600">These details shape the WhatsApp qualification conversation.</p>
            </div>

            <form method="post" action="/owner/settings/profile" class="mt-5 space-y-4">
                @Html.AntiForgeryToken()
                <div>
                    <label for="SiteName" class="mb-1.5 block text-sm font-semibold text-slate-700">Business name</label>
                    <input id="SiteName" name="SiteName" value="@Model.SiteName" required maxlength="120" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none ring-slate-200 focus:ring" />
                </div>
                <div>
                    <label for="BusinessSummary" class="mb-1.5 block text-sm font-semibold text-slate-700">Business summary</label>
                    <textarea id="BusinessSummary" name="BusinessSummary" maxlength="2000" rows="5" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none ring-slate-200 focus:ring" placeholder="What your business does, who it helps, and the services you offer">@Model.BusinessSummary</textarea>
                    <p class="mt-1 text-xs text-slate-500">Used by LeadRelay to keep qualification relevant to your business.</p>
                </div>
                <div>
                    <label for="IntroMessage" class="mb-1.5 block text-sm font-semibold text-slate-700">WhatsApp greeting</label>
                    <textarea id="IntroMessage" name="IntroMessage" maxlength="1000" rows="4" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none ring-slate-200 focus:ring" placeholder="Hi, thanks for getting in touch. I’ll ask a few quick questions to help the team respond.">@Model.IntroMessage</textarea>
                    <p class="mt-1 text-xs text-slate-500">Leave blank to use LeadRelay’s default greeting.</p>
                </div>

                <div class="border-t border-slate-200 pt-4">
                    <label for="AllowedDomains" class="mb-1.5 block text-sm font-semibold text-slate-700">Website domains</label>
                    <textarea id="AllowedDomains" name="AllowedDomains" rows="4" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 font-mono text-sm outline-none ring-slate-200 focus:ring" placeholder="example.com&#10;shop.example.com">@Model.AllowedDomains</textarea>
                    <p class="mt-1 text-xs text-slate-500">One per line. The widget works on each domain and its subdomains.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.AllowedDomains))
                {
                    <div>
                        <p class="mb-1.5 text-sm font-semibold text-slate-700">Widget snippet</p>
                        <pre class="overflow-x-auto rounded-xl bg-slate-950 p-3 text-xs text-slate-100"><code>@Model.WidgetSnippet</code></pre>
                        <textarea id="widgetSnippet" class="sr-only" readonly aria-hidden="true">@Model.WidgetSnippet</textarea>
                        <button type="button" class="mt-2 inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" onclick="navigator.clipboard.writeText(document.getElementById('widgetSnippet').value)">
                            <i data-lucide="copy" class="h-4 w-4"></i>
                            Copy snippet
                        </button>
                    </div>
                }

                <button class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700" type="submit">
                    <i data-lucide="save" class="h-4 w-4"></i>
                    Save business settings
                </button>
            </form>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-panel">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sky-700">Qualification</p>
                <h2 class="mt-1 font-display text-xl font-semibold text-slate-900">Lead questions</h2>
                <p class="mt-1 text-sm text-slate-600">Questions are asked from top to bottom. Reorder them to match your process.</p>
            </div>

            <form method="post" action="/owner/settings/fields" class="mt-5 space-y-3">
            @Html.AntiForgeryToken()

            <template x-for="(row, index) in rows" :key="index">
                <article class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <input type="hidden" :name="`fields[${index}].Id`" x-model="row.id" />

                    <div x-show="!row.editing" x-cloak class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-sm font-semibold text-slate-900" x-text="row.name || 'Untitled field'"></p>
                            <p class="mt-1 whitespace-pre-wrap text-sm text-slate-600" x-text="row.description || 'No description yet.'"></p>
                        </div>
                        <div class="flex shrink-0 flex-wrap justify-end gap-2">
                            <button type="button" class="rounded-lg border border-slate-300 bg-white p-1.5 text-slate-600 hover:bg-slate-100 disabled:opacity-40" title="Move up" :disabled="index === 0" @@click="moveRow(index, -1)"><i data-lucide="arrow-up" class="h-4 w-4"></i></button>
                            <button type="button" class="rounded-lg border border-slate-300 bg-white p-1.5 text-slate-600 hover:bg-slate-100 disabled:opacity-40" title="Move down" :disabled="index === rows.length - 1" @@click="moveRow(index, 1)"><i data-lucide="arrow-down" class="h-4 w-4"></i></button>
                            <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100" @@click="editRow(index)">Edit</button>
                            <button type="button" class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-100" @@click="removeRow(index)">Remove</button>
                        </div>
                    </div>

                    <div x-show="row.editing" x-cloak class="space-y-2">
                        <div>
                            <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.1em] text-slate-500">Name</label>
                            <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" x-model="row.name" :name="`fields[${index}].Name`" placeholder="Project overview" @@input="syncRowId(index)" />
                        </div>
                        <div>
                            <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.1em] text-slate-500">Description</label>
                            <textarea class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" x-model="row.description" :name="`fields[${index}].Description`" rows="3" placeholder="Optional guidance prompt"></textarea>
                        </div>
                        <div class="flex justify-end gap-2">
                            <button type="button" class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-100" @@click="removeRow(index)">Remove</button>
                            <button type="button" class="rounded-lg border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" @@click="finishEdit(index)">Done</button>
                        </div>
                    </div>

                    <template x-if="!row.editing">
                        <input type="hidden" :name="`fields[${index}].Name`" :value="row.name" />
                    </template>
                    <template x-if="!row.editing">
                        <input type="hidden" :name="`fields[${index}].Description`" :value="row.description" />
                    </template>
                </article>
            </template>

            <div class="flex flex-wrap gap-2">
                <button class="inline-flex items-center gap-2 rounded-md border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100" type="button" @@click="addRow()">
                    <i data-lucide="plus" class="h-4 w-4"></i>
                    <span>Add field</span>
                </button>
                <button class="inline-flex items-center gap-2 rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-700" type="submit">
                    <i data-lucide="save" class="h-4 w-4"></i>
                    <span>Save field definitions</span>
                </button>
            </div>
            </form>
        </section>
    </div>
</div>

@section HeadScripts {
<script>
    function fieldEditor(initialRows) {
        return {
            rows: initialRows && initialRows.length
                ? initialRows.map(row => ({ ...row, editing: false }))
                : [{ id: "", name: "", description: "", editing: true }],
            slugify(value) {
                return (value || "")
                    .toLowerCase()
                    .trim()
                    .replace(/[^a-z0-9\s_.-]/g, "")
                    .replace(/[\s.-]+/g, "_")
                    .replace(/^_+|_+$/g, "");
            },
            syncRowId(index) {
                if (!this.rows[index]) return;
                if ((this.rows[index].id || "").trim().length > 0) return;
                this.rows[index].id = this.slugify(this.rows[index].name);
            },
            editRow(index) {
                this.rows[index].editing = true;
            },
            finishEdit(index) {
                this.syncRowId(index);
                this.rows[index].editing = false;
            },
            addRow() {
                this.rows.push({ id: "", name: "", description: "", editing: true });
                this.$nextTick(() => window.refreshLucideIcons && window.refreshLucideIcons());
            },
            moveRow(index, offset) {
                const target = index + offset;
                if (target < 0 || target >= this.rows.length) return;
                const [row] = this.rows.splice(index, 1);
                this.rows.splice(target, 0, row);
                this.$nextTick(() => window.refreshLucideIcons && window.refreshLucideIcons());
            },
            removeRow(index) {
                this.rows.splice(index, 1);
                if (this.rows.length === 0) this.addRow();
                this.$nextTick(() => window.refreshLucideIcons && window.refreshLucideIcons());
            }
        };
    }
</script>
}
