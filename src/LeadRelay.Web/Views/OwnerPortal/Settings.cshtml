@using System.Text.Json
@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerSiteSettingsModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Owner settings";
    var initialRowsJson = JsonSerializer.Serialize(Model.Fields.Select(x => new
    {
        id = x.Id ?? "",
        name = x.Name ?? "",
        description = x.Description ?? ""
    }));
}

<div class="mx-auto max-w-6xl px-4 py-5 sm:px-6 lg:px-8" x-data='fieldEditor(@Html.Raw(initialRowsJson))' x-init="$nextTick(() => window.refreshLucideIcons && window.refreshLucideIcons())">
    <header class="mb-3 rounded-lg border border-slate-200 bg-white p-3 shadow-panel">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"><a class="hover:text-slate-700" href="/owner">Leads</a> / Settings</p>
                <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900">Project field definitions</h1>
                <p class="text-sm text-slate-600">@Model.SiteName · @Model.OwnerEmail</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="/owner" class="inline-flex items-center gap-2 rounded-md border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 transition hover:bg-sky-100">
                    <i data-lucide="arrow-left" class="h-4 w-4"></i>
                    <span>Back to leads</span>
                </a>
                <form method="post" action="/owner/logout" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center gap-2 rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-100">
                        <i data-lucide="log-out" class="h-4 w-4"></i>
                        <span>Sign out</span>
                    </button>
                </form>
            </div>
        </div>
    </header>

    <section class="rounded-lg border border-slate-200 bg-white p-3 shadow-panel">
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="mb-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@Model.Error</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Success))
        {
            <div class="mb-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@Model.Success</div>
        }

        <form method="post" action="/owner/settings/fields" class="space-y-3">
            @Html.AntiForgeryToken()

            <div class="hidden grid-cols-[1.1fr_1.2fr_2fr_auto] gap-2 px-1 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500 md:grid">
                <span>Field ID</span>
                <span>Name</span>
                <span>Description</span>
                <span></span>
            </div>

            <template x-for="(row, index) in rows" :key="index">
                <div class="rounded-md border border-slate-200 bg-slate-50 p-3">
                    <div class="grid gap-2 md:grid-cols-[1.1fr_1.2fr_2fr_auto]">
                        <div>
                            <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.1em] text-slate-500 md:hidden">Field ID</label>
                            <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" x-model="row.id" :name="`fields[${index}].Id`" placeholder="project_overview" />
                        </div>
                        <div>
                            <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.1em] text-slate-500 md:hidden">Name</label>
                            <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" x-model="row.name" :name="`fields[${index}].Name`" placeholder="Project overview" />
                        </div>
                        <div>
                            <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.1em] text-slate-500 md:hidden">Description</label>
                            <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" x-model="row.description" :name="`fields[${index}].Description`" placeholder="Optional guidance prompt" />
                        </div>
                        <button class="inline-flex items-center justify-center gap-1 rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-100" type="button" @@click="removeRow(index)">
                            <i data-lucide="trash-2" class="h-4 w-4"></i>
                            <span>Remove</span>
                        </button>
                    </div>
                </div>
            </template>

            <div class="flex flex-wrap gap-2">
                <button class="inline-flex items-center gap-2 rounded-md border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100" type="button" @@click="addRow()">
                    <i data-lucide="plus" class="h-4 w-4"></i>
                    <span>Add field</span>
                </button>
                <button class="inline-flex items-center gap-2 rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-700" type="submit">
                    <i data-lucide="save" class="h-4 w-4"></i>
                    <span>Save field definitions</span>
                </button>
            </div>
        </form>
    </section>
</div>

@section HeadScripts {
<script>
    function fieldEditor(initialRows) {
        return {
            rows: initialRows && initialRows.length ? initialRows : [{ id: "", name: "", description: "" }],
            addRow() {
                this.rows.push({ id: "", name: "", description: "" });
                this.$nextTick(() => window.refreshLucideIcons && window.refreshLucideIcons());
            },
            removeRow(index) {
                this.rows.splice(index, 1);
                if (this.rows.length === 0) this.addRow();
                this.$nextTick(() => window.refreshLucideIcons && window.refreshLucideIcons());
            }
        };
    }
</script>
}
