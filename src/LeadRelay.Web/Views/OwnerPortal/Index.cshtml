@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerDashboardModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Owner Leads Inbox</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap");

        :root {
            --bg: #f3f5f9;
            --ink: #162334;
            --muted: #5f6f86;
            --panel: #ffffff;
            --line: #d8e2ef;
            --accent: #0f62fe;
            --good-bg: #eefbf3;
            --good-ink: #176a41;
            --warn-bg: #fff6ea;
            --warn-ink: #8a5a08;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background:
                radial-gradient(840px 420px at 8% -8%, rgba(15, 98, 254, 0.08), transparent 62%),
                radial-gradient(840px 420px at 100% -12%, rgba(22, 196, 127, 0.08), transparent 58%),
                var(--bg);
            color: var(--ink);
            font-family: "Manrope", system-ui, -apple-system, Segoe UI, sans-serif;
        }

        .wrap { max-width: 1220px; margin: 0 auto; padding: 26px 18px 38px; }

        .top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 14px;
        }

        .title {
            margin: 0;
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(1.4rem, 2.8vw, 2rem);
            letter-spacing: -0.02em;
        }

        .meta { margin-top: 4px; color: var(--muted); font-size: 0.92rem; }

        .btn {
            border: 1px solid #c6d4e8;
            border-radius: 10px;
            background: #fff;
            padding: 9px 12px;
            color: #21344c;
            font: inherit;
            font-weight: 600;
            cursor: pointer;
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 14px;
        }

        .toolbar {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto auto;
            gap: 10px;
            padding: 12px;
            border-bottom: 1px solid #e8eef7;
        }

        .toolbar input,
        .toolbar select {
            border: 1px solid #c8d5e7;
            border-radius: 10px;
            padding: 9px 11px;
            font: inherit;
            color: var(--ink);
            background: #fff;
        }

        table { width: 100%; border-collapse: collapse; }
        th, td {
            text-align: left;
            padding: 11px 12px;
            border-bottom: 1px solid #e9eff8;
            vertical-align: middle;
            font-size: 0.92rem;
        }

        th {
            font-size: 0.79rem;
            letter-spacing: 0.04em;
            color: var(--muted);
            text-transform: uppercase;
            font-weight: 700;
            background: #f8fbff;
            position: sticky;
            top: 0;
        }

        tr:hover td { background: #fbfdff; }

        .status {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 4px 9px;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .status-good { background: var(--good-bg); color: var(--good-ink); }
        .status-warn { background: var(--warn-bg); color: var(--warn-ink); }

        .open-link {
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }

        .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            padding: 12px;
        }

        .paging {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .paging a,
        .paging span {
            border: 1px solid #ccd8ea;
            border-radius: 8px;
            padding: 6px 10px;
            text-decoration: none;
            font-size: 0.88rem;
            color: #2b3e57;
            background: #fff;
        }

        .paging .current {
            border-color: #8bb1ff;
            background: #eef4ff;
            color: #0f62fe;
            font-weight: 700;
        }

        .count {
            color: var(--muted);
            font-size: 0.9rem;
        }

        .empty {
            padding: 24px 14px;
            color: var(--muted);
        }

        @@media (max-width: 860px) {
            .toolbar { grid-template-columns: 1fr; }
            th:nth-child(3), td:nth-child(3) { display: none; }
        }
    </style>
</head>
<body>
<div class="wrap">
    <div class="top">
        <div>
            <h1 class="title">Leads Inbox</h1>
            <div class="meta">Site: <strong>@Model.SiteId</strong> · @Model.OwnerEmail</div>
        </div>
        <form method="post" action="/owner/logout" style="margin:0;">
            @Html.AntiForgeryToken()
            <button class="btn" type="submit">Sign out</button>
        </form>
    </div>

    <section class="panel">
        <form class="toolbar" method="get" action="/owner">
            <input type="text" name="q" value="@Model.Query" placeholder="Search name, email, or phone" />
            <select name="pageSize">
                @foreach (var size in new[] { 10, 20, 50, 100 })
                {
                    if (Model.PageSize == size)
                    {
                        <option value="@size" selected>@size / page</option>
                    }
                    else
                    {
                        <option value="@size">@size / page</option>
                    }
                }
            </select>
            <button class="btn" type="submit">Apply</button>
        </form>

        @if (Model.Leads.Count == 0)
        {
            <div class="empty">No leads match this view.</div>
        }
        else
        {
            <div style="overflow:auto; max-height: 64vh;">
                <table>
                    <thead>
                    <tr>
                        <th>Created</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var lead in Model.Leads)
                    {
                        var statusClass = string.Equals(lead.Status, "Contactable", StringComparison.OrdinalIgnoreCase)
                            ? "status status-good"
                            : "status status-warn";
                        <tr>
                            <td>@lead.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</td>
                            <td>@(string.IsNullOrWhiteSpace(lead.Name) ? "-" : lead.Name)</td>
                            <td>@(string.IsNullOrWhiteSpace(lead.Email) ? "-" : lead.Email)</td>
                            <td>@(string.IsNullOrWhiteSpace(lead.Phone) ? "-" : lead.Phone)</td>
                            <td><span class="@statusClass">@lead.Status</span></td>
                            <td><a class="open-link" href="/owner/leads/@lead.Id">Open</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <div class="footer">
            <div class="count">Showing @Model.StartItem-@Model.EndItem of @Model.TotalCount</div>
            <div class="paging">
                @if (Model.HasPrevious)
                {
                    <a href="/owner?q=@Uri.EscapeDataString(Model.Query)&page=@(Model.Page - 1)&pageSize=@Model.PageSize">Previous</a>
                }
                else
                {
                    <span>Previous</span>
                }

                <span class="current">Page @Model.Page of @Model.TotalPages</span>

                @if (Model.HasNext)
                {
                    <a href="/owner?q=@Uri.EscapeDataString(Model.Query)&page=@(Model.Page + 1)&pageSize=@Model.PageSize">Next</a>
                }
                else
                {
                    <span>Next</span>
                }
            </div>
        </div>
    </section>
</div>
</body>
</html>
