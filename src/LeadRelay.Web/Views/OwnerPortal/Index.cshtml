@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerDashboardModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Owner leads inbox";
    var contactableCount = Model.Leads.Count(x => string.Equals(x.Status, "Contactable", StringComparison.OrdinalIgnoreCase));
    var needsDetailsCount = Math.Max(0, Model.Leads.Count - contactableCount);
}

<div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8" x-data>
    <header class="mb-3 rounded-lg border border-slate-200 bg-white p-3 shadow-panel">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Owner workspace</p>
                <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900">Leads inbox</h1>
                <p class="text-sm text-slate-600">@Model.OwnerEmail</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="/owner/settings" class="inline-flex items-center gap-2 rounded-md border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100">
                    <i data-lucide="settings-2" class="h-4 w-4"></i>
                    <span>Settings</span>
                </a>
                <form method="post" action="/owner/logout" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center gap-2 rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-100">
                        <i data-lucide="log-out" class="h-4 w-4"></i>
                        <span>Sign out</span>
                    </button>
                </form>
            </div>
        </div>
    </header>

    <section class="mb-3 grid gap-2 sm:grid-cols-3">
        <article class="rounded-lg border border-sky-200 bg-sky-50 p-3 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Total in view</p>
            <p class="mt-1 font-display text-3xl font-semibold text-slate-900">@Model.TotalCount</p>
            <p class="mt-2 text-sm text-slate-600">Page @Model.Page of @Model.TotalPages</p>
        </article>
        <article class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-emerald-700">Contactable</p>
            <p class="mt-1 font-display text-3xl font-semibold text-slate-900">@contactableCount</p>
            <p class="mt-2 text-sm text-emerald-700">Ready for direct reply</p>
        </article>
        <article class="rounded-lg border border-amber-200 bg-amber-50 p-3 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-amber-700">Needs details</p>
            <p class="mt-1 font-display text-3xl font-semibold text-slate-900">@needsDetailsCount</p>
            <p class="mt-2 text-sm text-amber-700">Missing email or phone</p>
        </article>
    </section>

    <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-panel">
        <form class="border-b border-slate-200 bg-slate-50 p-3" method="get" action="/owner">
            <div class="grid gap-2 md:grid-cols-[1fr_auto_auto]">
                <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" type="text" name="q" value="@Model.Query" placeholder="Search name, email, or phone" />
                <select class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" name="pageSize">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        if (Model.PageSize == size)
                        {
                            <option value="@size" selected>@size per page</option>
                        }
                        else
                        {
                            <option value="@size">@size per page</option>
                        }
                    }
                </select>
                <button class="rounded-md border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 transition hover:bg-sky-100" type="submit">Apply</button>
            </div>
        </form>

        @if (Model.Leads.Count == 0)
        {
            <div class="p-6 text-sm text-slate-500">No leads match this view.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Created</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Name</th>
                        <th class="hidden px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 lg:table-cell">Email</th>
                        <th class="hidden px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 lg:table-cell">Phone</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Status</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 bg-white">
                    @foreach (var lead in Model.Leads)
                    {
                        var isContactable = string.Equals(lead.Status, "Contactable", StringComparison.OrdinalIgnoreCase);
                        <tr class="hover:bg-slate-50">
                            <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-700">@lead.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</td>
                            <td class="px-4 py-3 text-sm font-medium text-slate-900">@(string.IsNullOrWhiteSpace(lead.Name) ? "-" : lead.Name)</td>
                            <td class="hidden px-4 py-3 text-sm text-slate-700 lg:table-cell">@(string.IsNullOrWhiteSpace(lead.Email) ? "-" : lead.Email)</td>
                            <td class="hidden px-4 py-3 text-sm text-slate-700 lg:table-cell">@(string.IsNullOrWhiteSpace(lead.Phone) ? "-" : lead.Phone)</td>
                            <td class="px-4 py-3 text-sm">
                                <span class="inline-flex rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.08em] @(isContactable ? "border border-emerald-200 bg-emerald-50 text-emerald-700" : "border border-amber-200 bg-amber-50 text-amber-700")">@lead.Status</span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <a class="inline-flex items-center gap-1 rounded-md border border-sky-200 bg-sky-50 px-3 py-1.5 text-sm font-semibold text-sky-700 transition hover:bg-sky-100" href="/owner/leads/@lead.Id">
                                    <i data-lucide="arrow-up-right" class="h-3.5 w-3.5"></i>
                                    <span>Open</span>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 p-3">
            <p class="text-sm text-slate-500">Showing @Model.StartItem-@Model.EndItem of @Model.TotalCount</p>
            <div class="flex items-center gap-2 text-sm">
                @if (Model.HasPrevious)
                {
                    <a class="rounded-md border border-sky-200 bg-sky-50 px-3 py-1.5 font-medium text-sky-700 hover:bg-sky-100" href="/owner?q=@Uri.EscapeDataString(Model.Query)&page=@(Model.Page - 1)&pageSize=@Model.PageSize">Previous</a>
                }
                else
                {
                    <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-400">Previous</span>
                }

                <span class="rounded-md border border-indigo-200 bg-indigo-50 px-3 py-1.5 font-semibold text-indigo-700">Page @Model.Page of @Model.TotalPages</span>

                @if (Model.HasNext)
                {
                    <a class="rounded-md border border-sky-200 bg-sky-50 px-3 py-1.5 font-medium text-sky-700 hover:bg-sky-100" href="/owner?q=@Uri.EscapeDataString(Model.Query)&page=@(Model.Page + 1)&pageSize=@Model.PageSize">Next</a>
                }
                else
                {
                    <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-400">Next</span>
                }
            </div>
        </div>
    </section>
</div>
