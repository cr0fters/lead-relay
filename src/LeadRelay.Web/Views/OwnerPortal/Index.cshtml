@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerDashboardModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Leads inbox";
    var selectedStageLabel = string.IsNullOrWhiteSpace(Model.Stage)
        ? "All stages"
        : char.ToUpperInvariant(Model.Stage[0]) + Model.Stage[1..];
    var selectedDateLabel = string.IsNullOrWhiteSpace(Model.FromDate) && string.IsNullOrWhiteSpace(Model.ToDate)
        ? "Any date"
        : $"{(string.IsNullOrWhiteSpace(Model.FromDate) ? "Any" : Model.FromDate)} to {(string.IsNullOrWhiteSpace(Model.ToDate) ? "today" : Model.ToDate)}";
    string PageUrl(int targetPage) => Url.Action("Index", "OwnerPortal", new
    {
        q = Model.Query,
        stage = Model.Stage,
        from = Model.FromDate,
        to = Model.ToDate,
        page = targetPage,
        pageSize = Model.PageSize
    }) ?? "/owner";
}

<div class="w-full px-4 py-5 sm:px-6 lg:px-8" x-data>
    <header class="mb-3 rounded-lg border border-slate-200 bg-white p-3 shadow-panel">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Workspace</p>
                <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900">Leads inbox</h1>
                <p class="text-sm text-slate-600">Track conversations, review lead quality, and respond quickly.</p>
            </div>
            <a class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" href="/owner/leads/export.csv">
                <i data-lucide="download" class="h-4 w-4"></i>
                <span>Export CSV</span>
            </a>
        </div>
    </header>

    <section class="mb-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-lg border border-sky-200 bg-sky-50 p-3 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Total in view</p>
            <p class="mt-1 font-display text-3xl font-semibold text-slate-900">@Model.TotalCount</p>
            <p class="mt-2 text-sm text-slate-600">Page @Model.Page of @Model.TotalPages</p>
        </article>
        <article class="rounded-lg border border-violet-200 bg-violet-50 p-3 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-violet-700">New leads</p>
            <p class="mt-1 font-display text-3xl font-semibold text-slate-900">@Model.NewCount</p>
            <p class="mt-2 text-sm text-violet-700">Not opened yet</p>
        </article>
        <article class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-emerald-700">Stage filter</p>
            <p class="mt-1 font-display text-xl font-semibold text-slate-900">@selectedStageLabel</p>
            <p class="mt-2 text-sm text-emerald-700">Owner-controlled pipeline</p>
        </article>
        <article class="rounded-lg border border-amber-200 bg-amber-50 p-3 shadow-panel">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-amber-700">Created</p>
            <p class="mt-1 font-display text-lg font-semibold text-slate-900">@selectedDateLabel</p>
            <p class="mt-2 text-sm text-amber-700">UTC date range</p>
        </article>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="mb-3 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@Model.Error</div>
    }

    <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-panel">
        <form class="border-b border-slate-200 bg-slate-50 p-3" method="get" action="/owner">
            <div class="grid gap-2 md:grid-cols-2 xl:grid-cols-[minmax(240px,1fr)_auto_auto_auto_auto_auto]">
                <label class="sr-only" for="lead-search">Search leads</label>
                <input id="lead-search" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" type="search" name="q" value="@Model.Query" placeholder="Search name, email, or phone" />
                <label class="sr-only" for="stage-filter">Stage</label>
                <select id="stage-filter" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" name="stage">
                    <option value="">All stages</option>
                    @foreach (var option in new[] { "new", "qualified", "contacted", "won", "lost" })
                    {
                        var label = char.ToUpperInvariant(option[0]) + option[1..];
                        if (string.Equals(Model.Stage, option, StringComparison.Ordinal))
                        {
                            <option value="@option" selected>@label</option>
                        }
                        else
                        {
                            <option value="@option">@label</option>
                        }
                    }
                </select>
                <div>
                    <label class="sr-only" for="from-filter">Created from</label>
                    <input id="from-filter" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" type="date" name="from" value="@Model.FromDate" title="Created from" />
                </div>
                <div>
                    <label class="sr-only" for="to-filter">Created to</label>
                    <input id="to-filter" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" type="date" name="to" value="@Model.ToDate" title="Created to" />
                </div>
                <label class="sr-only" for="page-size">Results per page</label>
                <select id="page-size" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" name="pageSize">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        if (Model.PageSize == size)
                        {
                            <option value="@size" selected>@size per page</option>
                        }
                        else
                        {
                            <option value="@size">@size per page</option>
                        }
                    }
                </select>
                <button class="rounded-md border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 transition hover:bg-sky-100" type="submit">Apply</button>
                @if (!string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.Stage) || !string.IsNullOrWhiteSpace(Model.FromDate) || !string.IsNullOrWhiteSpace(Model.ToDate))
                {
                    <a class="rounded-md border border-slate-200 bg-white px-4 py-2 text-center text-sm font-semibold text-slate-700 transition hover:bg-slate-100" href="/owner">Clear</a>
                }
            </div>
        </form>

        @if (Model.Leads.Count == 0)
        {
            if (Model.HasActiveFilters)
            {
                <div class="p-6 text-center">
                    <div class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-slate-100 text-slate-500">
                        <i data-lucide="search-x" class="h-5 w-5"></i>
                    </div>
                    <h2 class="mt-3 text-base font-semibold text-slate-900">No leads match these filters</h2>
                    <p class="mt-1 text-sm text-slate-500">Clear the filters or try a broader search.</p>
                    <a class="mt-4 inline-flex rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" href="/owner">Clear filters</a>
                </div>
            }
            else
            {
                <div class="p-6 text-center sm:p-10">
                    <div class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-emerald-50 text-emerald-700">
                        <i data-lucide="message-circle" class="h-6 w-6"></i>
                    </div>
                    <h2 class="mt-3 text-lg font-semibold text-slate-900">Capture your first WhatsApp lead</h2>
                    <p class="mx-auto mt-1 max-w-xl text-sm leading-6 text-slate-600">Finish connecting WhatsApp, install the widget on your website, and send a test enquiry. New leads will appear here automatically.</p>
                    <a class="mt-4 inline-flex items-center gap-2 rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700" href="/owner/onboarding">
                        <i data-lucide="list-checks" class="h-4 w-4"></i>
                        <span>Continue setup</span>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Created</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Name</th>
                        <th class="hidden px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 lg:table-cell">Email</th>
                        <th class="hidden px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 lg:table-cell">Phone</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Stage</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 bg-white">
                    @foreach (var lead in Model.Leads)
                    {
                        var stageLabel = char.ToUpperInvariant(lead.ProjectStage[0]) + lead.ProjectStage[1..];
                        var stageClass = lead.ProjectStage switch
                        {
                            "won" => "border border-emerald-200 bg-emerald-50 text-emerald-700",
                            "lost" => "border border-slate-300 bg-slate-100 text-slate-600",
                            "qualified" => "border border-indigo-200 bg-indigo-50 text-indigo-700",
                            "contacted" => "border border-sky-200 bg-sky-50 text-sky-700",
                            _ => "border border-amber-200 bg-amber-50 text-amber-700"
                        };
                        <tr class="@(lead.IsNew ? "bg-violet-50/50" : "") hover:bg-slate-50">
                            <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-700">@lead.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</td>
                            <td class="px-4 py-3 text-sm font-medium text-slate-900">
                                <span>@(string.IsNullOrWhiteSpace(lead.Name) ? "-" : lead.Name)</span>
                                @if (lead.IsNew)
                                {
                                    <span class="ml-2 inline-flex rounded-full border border-violet-200 bg-violet-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.08em] text-violet-700">New</span>
                                }
                            </td>
                            <td class="hidden px-4 py-3 text-sm text-slate-700 lg:table-cell">@(string.IsNullOrWhiteSpace(lead.Email) ? "-" : lead.Email)</td>
                            <td class="hidden px-4 py-3 text-sm text-slate-700 lg:table-cell">@(string.IsNullOrWhiteSpace(lead.Phone) ? "-" : lead.Phone)</td>
                            <td class="px-4 py-3 text-sm">
                                <span class="inline-flex rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.08em] @stageClass">@stageLabel</span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <a class="inline-flex items-center gap-1 rounded-md border border-sky-200 bg-sky-50 px-3 py-1.5 text-sm font-semibold text-sky-700 transition hover:bg-sky-100" href="/owner/leads/@lead.Id">
                                    <i data-lucide="arrow-up-right" class="h-3.5 w-3.5"></i>
                                    <span>Open</span>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 p-3">
            <p class="text-sm text-slate-500">Showing @Model.StartItem-@Model.EndItem of @Model.TotalCount</p>
            <div class="flex items-center gap-2 text-sm">
                @if (Model.HasPrevious)
                {
                    <a class="rounded-md border border-sky-200 bg-sky-50 px-3 py-1.5 font-medium text-sky-700 hover:bg-sky-100" href="@PageUrl(Model.Page - 1)">Previous</a>
                }
                else
                {
                    <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-400">Previous</span>
                }

                <span class="rounded-md border border-indigo-200 bg-indigo-50 px-3 py-1.5 font-semibold text-indigo-700">Page @Model.Page of @Model.TotalPages</span>

                @if (Model.HasNext)
                {
                    <a class="rounded-md border border-sky-200 bg-sky-50 px-3 py-1.5 font-medium text-sky-700 hover:bg-sky-100" href="@PageUrl(Model.Page + 1)">Next</a>
                }
                else
                {
                    <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-400">Next</span>
                }
            </div>
        </div>
    </section>
</div>
