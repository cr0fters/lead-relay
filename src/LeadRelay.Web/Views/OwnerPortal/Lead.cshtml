@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerLeadDetailModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lead CRM View</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap");

        :root {
            --bg: #f3f5f9;
            --ink: #152132;
            --muted: #5f6f86;
            --panel: #ffffff;
            --line: #d9e1ec;
            --accent: #0f62fe;
            --accent-2: #13b886;
            --danger: #c53838;
            --danger-bg: #fff1f1;
            --ok: #126b3f;
            --ok-bg: #eefcf4;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            color: var(--ink);
            background:
                radial-gradient(720px 380px at 0 -10%, rgba(15, 98, 254, 0.08), transparent 60%),
                radial-gradient(900px 420px at 100% -20%, rgba(19, 184, 134, 0.08), transparent 60%),
                var(--bg);
            font-family: "Manrope", system-ui, -apple-system, Segoe UI, sans-serif;
        }

        a { color: var(--accent); text-decoration: none; }

        .wrap {
            max-width: 1240px;
            margin: 0 auto;
            padding: 28px 18px 42px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .crumb {
            color: var(--muted);
            font-size: 0.94rem;
        }

        .headline {
            display: grid;
            gap: 4px;
            margin-bottom: 16px;
        }

        .headline h1 {
            margin: 0;
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(1.45rem, 2.8vw, 2rem);
            letter-spacing: -0.02em;
        }

        .subline {
            color: var(--muted);
            font-size: 0.95rem;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .flash {
            border-radius: 10px;
            padding: 10px 12px;
            margin-bottom: 14px;
            border: 1px solid transparent;
            font-size: 0.95rem;
        }

        .flash-error {
            color: var(--danger);
            background: var(--danger-bg);
            border-color: #efb6b6;
        }

        .flash-ok {
            color: var(--ok);
            background: var(--ok-bg);
            border-color: #bde8cf;
        }

        .layout {
            display: grid;
            grid-template-columns: 350px minmax(0, 1fr);
            gap: 14px;
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 14px;
        }

        .section {
            padding: 14px;
            border-bottom: 1px solid #edf1f7;
        }

        .section:last-child { border-bottom: 0; }

        .kicker {
            margin: 0 0 10px;
            font-size: 0.76rem;
            letter-spacing: 0.08em;
            color: var(--muted);
            text-transform: uppercase;
            font-weight: 700;
        }

        .field-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 10px;
        }

        .summary-card {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 12px;
            align-items: start;
            border: 1px solid #cfe0ff;
            background: linear-gradient(180deg, #f4f8ff, #eef4ff);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 10px;
        }

        .summary-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            font-size: 0.82rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            color: #0f62fe;
            background: #fff;
            border: 1px solid #c5d8ff;
        }

        .summary-text {
            margin: 0;
            white-space: pre-wrap;
            line-height: 1.4;
            color: #193252;
            font-weight: 500;
        }

        .captured-list {
            display: grid;
            gap: 10px;
            margin-bottom: 10px;
        }

        .captured-row {
            border: 1px solid #e4ebf4;
            border-radius: 10px;
            padding: 10px;
            background: #fafcfe;
        }

        .field {
            border: 1px solid #e4ebf4;
            border-radius: 10px;
            padding: 10px;
            background: #fafcfe;
        }

        .field .label {
            color: var(--muted);
            font-size: 0.76rem;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
        }

        .field .value {
            font-weight: 600;
            font-size: 0.95rem;
            overflow-wrap: anywhere;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        input[type="text"],
        input[type="email"],
        input[type="tel"],
        select,
        textarea {
            width: 100%;
            border: 1px solid #c8d5e7;
            border-radius: 10px;
            font: inherit;
            padding: 10px 11px;
            background: #fff;
            color: var(--ink);
        }

        textarea {
            min-height: 112px;
            resize: vertical;
        }

        .btn {
            border: 0;
            border-radius: 10px;
            padding: 10px 12px;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--accent);
            color: #fff;
        }

        .btn-secondary {
            background: #eef3fb;
            color: #24364e;
            border: 1px solid #cfdbee;
        }

        .btn-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 8px;
        }

        .meta-list {
            margin: 0;
            padding: 0;
            list-style: none;
            display: grid;
            gap: 8px;
        }

        .meta-list li {
            padding: 9px 10px;
            border: 1px solid #e5ebf5;
            border-radius: 10px;
            background: #fbfcff;
            font-size: 0.93rem;
        }

        .timeline {
            display: grid;
            gap: 8px;
            max-height: 460px;
            overflow: auto;
            padding-right: 4px;
            background:
                linear-gradient(180deg, rgba(8, 127, 91, 0.06), rgba(8, 127, 91, 0.02)),
                #f6faf8;
            border: 1px solid #d6e7de;
            border-radius: 12px;
            padding: 12px;
        }

        .chat-msg {
            display: grid;
            gap: 4px;
            max-width: 86%;
        }

        .chat-msg.incoming {
            justify-self: start;
        }

        .chat-msg.outgoing {
            justify-self: end;
        }

        .chat-meta {
            display: flex;
            gap: 8px;
            font-size: 0.8rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .chat-bubble {
            white-space: pre-wrap;
            line-height: 1.4;
            font-size: 0.94rem;
            padding: 10px 12px;
            border-radius: 12px;
            border: 1px solid #d8e2df;
            background: #fff;
            box-shadow: 0 1px 0 rgba(0, 0, 0, 0.03);
        }

        .chat-msg.incoming .chat-bubble {
            border-bottom-left-radius: 6px;
            background: #ffffff;
            position: relative;
        }

        .chat-msg.incoming .chat-bubble::before {
            content: "";
            position: absolute;
            left: -6px;
            top: 10px;
            width: 10px;
            height: 10px;
            background: #ffffff;
            border-left: 1px solid #d8e2df;
            border-bottom: 1px solid #d8e2df;
            transform: rotate(45deg);
        }

        .chat-msg.outgoing .chat-bubble {
            border-bottom-right-radius: 6px;
            border-color: #b8dfc5;
            background: #dcf8c6;
            position: relative;
        }

        .chat-msg.outgoing .chat-bubble::after {
            content: "";
            position: absolute;
            right: -6px;
            top: 10px;
            width: 10px;
            height: 10px;
            background: #dcf8c6;
            border-right: 1px solid #b8dfc5;
            border-top: 1px solid #b8dfc5;
            transform: rotate(45deg);
        }

        .composer {
            border-top: 1px solid #edf1f7;
            background: #fff;
            padding-top: 14px;
        }

        .helper {
            color: var(--muted);
            font-size: 0.84rem;
            margin-top: 6px;
        }

        @@media (max-width: 980px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .timeline {
                max-height: none;
            }
        }
    </style>
</head>
<body>
<div class="wrap">
    <div class="topbar">
        <div class="crumb"><a href="/owner">Leads</a> / @Model.Id</div>
        <div class="top-actions">
            <a class="btn btn-secondary" href="/owner/settings">Settings</a>
            <form method="post" action="/owner/logout" style="margin:0;">
                @Html.AntiForgeryToken()
                <button class="btn btn-secondary" type="submit">Sign out</button>
            </form>
        </div>
    </div>

    <div class="headline">
        <h1>Lead Workspace</h1>
        <div class="subline">
            <span>Owner: <strong>@Model.OwnerEmail</strong></span>
            <span>Created: <strong>@Model.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</strong></span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="flash flash-error">@Model.Error</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Success))
    {
        <div class="flash flash-ok">@Model.Success</div>
    }

    <div class="layout">
        <aside class="panel">
            <section class="section">
                <h2 class="kicker">Contact Profile</h2>
                <div class="field-grid">
                    <div class="field">
                        <div class="label">Name</div>
                        <div class="value">@(string.IsNullOrWhiteSpace(Model.Name) ? "-" : Model.Name)</div>
                    </div>
                    <div class="field">
                        <div class="label">Channel</div>
                        <div class="value">@Model.Channel</div>
                    </div>
                    <div class="field">
                        <div class="label">Status</div>
                        <div class="value">@Model.Status</div>
                    </div>
                    <div class="field">
                        <div class="label">Email</div>
                        <div class="value">@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</div>
                    </div>
                    <div class="field">
                        <div class="label">Phone</div>
                        <div class="value">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</div>
                    </div>
                </div>
            </section>

            <section class="section">
                <h2 class="kicker">Conversation Control</h2>
                <form method="post" action="/owner/leads/@Model.Id/pause">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="paused" value="@(Model.IsPaused ? "false" : "true")" />
                    <div class="btn-row">
                        <button class="btn btn-secondary" type="submit">@(Model.IsPaused ? "Resume Conversation" : "Pause Conversation")</button>
                    </div>
                </form>
            </section>

            <section class="section">
                <h2 class="kicker">Edit Contact</h2>
                <form method="post" action="/owner/leads/@Model.Id/contact">
                    @Html.AntiForgeryToken()

                    <label for="name">Name</label>
                    <input id="name" name="name" type="text" value="@Model.Name" />

                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" value="@Model.Email" />

                    <label for="phone">Phone</label>
                    <input id="phone" name="phone" type="tel" value="@Model.Phone" />

                    <div class="btn-row">
                        <button class="btn btn-secondary" type="submit">Save Contact</button>
                    </div>
                </form>
            </section>

            <section class="section">
                <h2 class="kicker">Captured Fields</h2>
                <form method="post" action="/owner/leads/@Model.Id/fields">
                    @Html.AntiForgeryToken()
                @if (Model.FieldDefinitions.Count == 0)
                {
                    <div class="helper">No captured fields.</div>
                }
                else
                {
                    <div class="captured-list">
                        @foreach (var field in Model.FieldDefinitions)
                        {
                            <div class="captured-row">
                                <label for="fld_@field.Id">@field.Name</label>
                                <input id="fld_@field.Id" name="fields[@field.Id]" type="text" value="@field.Value" />
                                @if (!string.IsNullOrWhiteSpace(field.Description))
                                {
                                    <div class="helper">@field.Description</div>
                                }
                            </div>
                        }
                    </div>
                }
                    <div class="btn-row">
                        <button class="btn btn-secondary" type="submit">Save Fields</button>
                    </div>
                </form>
            </section>
        </aside>

        <main class="panel">
            <section class="section">
                <h2 class="kicker">Project Summary</h2>
                <div class="summary-card">
                    <div class="summary-icon">AI</div>
                    <p class="summary-text">@(string.IsNullOrWhiteSpace(Model.ProjectSummary) ? "No summary yet." : Model.ProjectSummary)</p>
                </div>
            </section>

            <section class="section">
                <h2 class="kicker">Conversation History</h2>
                @if (Model.Conversation.Count == 0)
                {
                    <div class="helper">No messages yet.</div>
                }
                else
                {
                    <div id="conversationTimeline" class="timeline">
                        @foreach (var turn in Model.Conversation)
                        {
                            var isIncoming = string.Equals(turn.Role, "user", StringComparison.OrdinalIgnoreCase) ||
                                             string.Equals(turn.Role, "customer", StringComparison.OrdinalIgnoreCase);
                            var roleLabel = isIncoming ? "Customer" : "LeadRelay";
                            <article class="chat-msg @(isIncoming ? "incoming" : "outgoing")">
                                <div class="chat-meta">
                                    <span>@roleLabel</span>
                                    <span>@turn.AtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                </div>
                                <div class="chat-bubble">@turn.Text</div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="section composer">
                <h2 class="kicker">Reply Composer</h2>
                <form method="post" action="/owner/leads/@Model.Id/reply">
                    @Html.AntiForgeryToken()

                    <label for="replyChannel">Send Via</label>
                    <select id="replyChannel" name="replyChannel">
                        @if (Model.CanReplyViaWhatsApp)
                        {
                            if (string.Equals(Model.ReplyChannel, "whatsapp", StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="whatsapp" selected>WhatsApp</option>
                            }
                            else
                            {
                                <option value="whatsapp">WhatsApp</option>
                            }
                        }
                        @if (Model.CanReplyViaEmail)
                        {
                            if (string.Equals(Model.ReplyChannel, "email", StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="email" selected>Email</option>
                            }
                            else
                            {
                                <option value="email">Email</option>
                            }
                        }
                    </select>

                    <label for="message">Message</label>
                    <textarea id="message" name="message" placeholder="Write your message to the customer..." required></textarea>
                    <div class="helper">Use channel based on available contact details.</div>

                    <div class="btn-row">
                        <button class="btn btn-primary" type="submit">Send Reply</button>
                    </div>
                </form>
            </section>
        </main>
    </div>
</div>
<script>
    (function () {
        var timeline = document.getElementById("conversationTimeline");
        if (!timeline) return;
        timeline.scrollTop = timeline.scrollHeight;
    })();
</script>
</body>
</html>
