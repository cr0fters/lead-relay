@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerLeadDetailModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Lead Workspace";
}

<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8" x-data>
    <header class="mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-panel">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"><a class="hover:text-sky-700" href="/owner">Leads</a> / @Model.Id</p>
                <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900">Lead Workspace</h1>
                <p class="text-sm text-slate-600">Owner: @Model.OwnerEmail · Created: @Model.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="/owner/settings" class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400">
                    <i data-lucide="settings-2" class="h-4 w-4"></i>
                    <span>Settings</span>
                </a>
                <form method="post" action="/owner/logout" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400">
                        <i data-lucide="log-out" class="h-4 w-4"></i>
                        <span>Sign out</span>
                    </button>
                </form>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="mb-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@Model.Error</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Success))
    {
        <div class="mb-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@Model.Success</div>
    }

    <div class="grid gap-4 lg:grid-cols-[360px_1fr]">
        <aside class="space-y-4">
            <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-panel">
                <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Contact Profile</h2>
                <div class="grid gap-2 sm:grid-cols-2">
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5"><p class="text-xs uppercase tracking-[0.1em] text-slate-500">Name</p><p class="text-sm font-semibold">@(string.IsNullOrWhiteSpace(Model.Name) ? "-" : Model.Name)</p></div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5"><p class="text-xs uppercase tracking-[0.1em] text-slate-500">Channel</p><p class="text-sm font-semibold">@Model.Channel</p></div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5"><p class="text-xs uppercase tracking-[0.1em] text-slate-500">Status</p><p class="text-sm font-semibold">@Model.Status</p></div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5"><p class="text-xs uppercase tracking-[0.1em] text-slate-500">Bot</p><p class="text-sm font-semibold">@(Model.IsPaused ? "Paused" : "Active")</p></div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5 sm:col-span-2"><p class="text-xs uppercase tracking-[0.1em] text-slate-500">Email</p><p class="text-sm font-semibold break-all">@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</p></div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5 sm:col-span-2"><p class="text-xs uppercase tracking-[0.1em] text-slate-500">Phone</p><p class="text-sm font-semibold break-all">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</p></div>
                </div>
            </section>

            <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-panel">
                <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Conversation Control</h2>
                <form method="post" action="/owner/leads/@Model.Id/pause" x-data="{ paused: @(Model.IsPaused ? "true" : "false") }">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="paused" :value="paused ? 'true' : 'false'" />
                    <div class="flex items-center justify-between rounded-md border border-slate-200 bg-slate-50 px-3 py-2">
                        <div>
                            <p class="text-sm font-semibold text-slate-800">Pause Conversation</p>
                            <p class="text-xs text-slate-500">Turn off auto replies for this lead</p>
                        </div>
                        <label class="relative inline-flex cursor-pointer items-center">
                            <input type="checkbox" class="peer sr-only" x-model="paused" @@change="$el.form.submit()" />
                            <span class="h-6 w-11 rounded-full bg-slate-300 transition peer-checked:bg-slate-700"></span>
                            <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
                        </label>
                    </div>
                </form>
            </section>

            <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-panel">
                <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Edit Contact</h2>
                <form method="post" action="/owner/leads/@Model.Id/contact" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="name">Name</label>
                        <input class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="name" name="name" type="text" value="@Model.Name" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="email">Email</label>
                        <input class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="email" name="email" type="email" value="@Model.Email" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="phone">Phone</label>
                        <input class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="phone" name="phone" type="tel" value="@Model.Phone" />
                    </div>
                    <button class="w-full rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400" type="submit">Save Contact</button>
                </form>
            </section>

            <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-panel">
                <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Captured Fields</h2>
                <form method="post" action="/owner/leads/@Model.Id/fields" class="space-y-3">
                    @Html.AntiForgeryToken()
                    @if (Model.FieldDefinitions.Count == 0)
                    {
                        <div class="text-sm text-slate-500">No captured fields.</div>
                    }
                    else
                    {
                        foreach (var field in Model.FieldDefinitions)
                        {
                            <div class="rounded-md border border-slate-200 bg-slate-50 p-3">
                                <label class="mb-1 block text-sm font-semibold text-slate-700" for="fld_@field.Id">@field.Name</label>
                                <input class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="fld_@field.Id" name="fields[@field.Id]" type="text" value="@field.Value" />
                                @if (!string.IsNullOrWhiteSpace(field.Description))
                                {
                                    <p class="mt-1 text-xs text-slate-500">@field.Description</p>
                                }
                            </div>
                        }
                    }
                    <button class="w-full rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400" type="submit">Save Fields</button>
                </form>
            </section>
        </aside>

        <main class="space-y-4">
            <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-panel">
                <div class="mb-2 flex items-center gap-2 text-slate-700">
                    <i data-lucide="sparkles" class="h-4 w-4"></i>
                    <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-600">AI Summary</h2>
                </div>
                <p class="rounded-md border border-slate-200 bg-slate-50 p-3 text-sm leading-6 text-slate-700">@(string.IsNullOrWhiteSpace(Model.ProjectSummary) ? "No summary yet." : Model.ProjectSummary)</p>
            </section>

            <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-panel">
                <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Conversation History</h2>
                @if (Model.Conversation.Count == 0)
                {
                    <div class="text-sm text-slate-500">No messages yet.</div>
                }
                else
                {
                    <div id="conversationTimeline" class="max-h-[34rem] space-y-2 overflow-auto rounded-md border border-slate-200 bg-slate-50 p-3">
                        @foreach (var turn in Model.Conversation)
                        {
                            var isIncoming = string.Equals(turn.Role, "user", StringComparison.OrdinalIgnoreCase) ||
                                             string.Equals(turn.Role, "customer", StringComparison.OrdinalIgnoreCase);
                            var roleLabel = isIncoming ? "Customer" : "LeadRelay";
                            <article class="max-w-[85%] @(isIncoming ? "mr-auto" : "ml-auto")">
                                <p class="mb-1 text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-500">@roleLabel · @turn.AtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</p>
                                <div class="rounded-md border px-3 py-2 text-sm leading-6 @(isIncoming ? "border-slate-200 bg-white text-slate-800" : "border-slate-300 bg-slate-100 text-slate-800")">@turn.Text</div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-panel">
                <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Reply Composer</h2>
                <form method="post" action="/owner/leads/@Model.Id/reply" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="replyChannel">Send via</label>
                        <select class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="replyChannel" name="replyChannel">
                            @if (Model.CanReplyViaWhatsApp)
                            {
                                if (string.Equals(Model.ReplyChannel, "whatsapp", StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="whatsapp" selected>WhatsApp</option>
                                }
                                else
                                {
                                    <option value="whatsapp">WhatsApp</option>
                                }
                            }
                            @if (Model.CanReplyViaEmail)
                            {
                                if (string.Equals(Model.ReplyChannel, "email", StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="email" selected>Email</option>
                                }
                                else
                                {
                                    <option value="email">Email</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="message">Message</label>
                        <textarea class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="message" name="message" rows="5" placeholder="Write your message to the customer..." required></textarea>
                        <p class="mt-1 text-xs text-slate-500">Use channel based on available contact details.</p>
                    </div>
                    <button class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400" type="submit">
                        <i data-lucide="send" class="h-4 w-4"></i>
                        <span>Send Reply</span>
                    </button>
                </form>
            </section>
        </main>
    </div>
</div>

@section PageScripts {
<script>
    (function () {
        var timeline = document.getElementById("conversationTimeline");
        if (!timeline) return;
        timeline.scrollTop = timeline.scrollHeight;
    })();
</script>
}
