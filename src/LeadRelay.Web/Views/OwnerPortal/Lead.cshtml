@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerLeadDetailModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var leadDisplayName = string.IsNullOrWhiteSpace(Model.Name) ? "Unnamed lead" : Model.Name!;
    ViewData["Title"] = leadDisplayName;
    var hasActivity = Model.Activity.Count > 0;
    var hasFields = Model.FieldDefinitions.Count > 0;
}

<div class="w-full px-4 py-5 sm:px-6 xl:px-8" x-data="leadWorkspace(@(Model.IsPaused ? "true" : "false"))">
    <header class="mb-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-panel">
        <div class="grid gap-3 xl:grid-cols-[minmax(0,1fr)_minmax(560px,1.2fr)] xl:items-center">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"><a class="hover:text-slate-700" href="/owner">Leads</a> / @Model.Id</p>
                <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900">@leadDisplayName</h1>
                <p class="text-sm text-slate-600">Created: @Model.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</p>
            </div>

            <div class="grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                <article class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
                    <form method="post" action="/owner/leads/@Model.Id/stage">
                        @Html.AntiForgeryToken()
                        <label class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500" for="lead-stage">Stage</label>
                        <div class="mt-1 flex items-center gap-1.5">
                            <select id="lead-stage" name="stage" class="min-w-0 flex-1 rounded-md border border-slate-300 bg-white px-2 py-1 text-sm font-semibold text-slate-900 outline-none ring-slate-200 focus:ring">
                                @foreach (var stage in Model.StageOptions)
                                {
                                    if (string.Equals(Model.ProjectStage, stage.Value, StringComparison.Ordinal))
                                    {
                                        <option value="@stage.Value" selected>@stage.Label</option>
                                    }
                                    else
                                    {
                                        <option value="@stage.Value">@stage.Label</option>
                                    }
                                }
                            </select>
                            <button class="rounded-md border border-slate-300 bg-white px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100" type="submit">Save</button>
                        </div>
                    </form>
                </article>
                <article class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Channel</p>
                    <p class="mt-1 text-sm font-semibold text-slate-900">@Model.Channel</p>
                </article>
                <article class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Messages</p>
                    <p class="mt-1 text-sm font-semibold text-slate-900">@Model.Conversation.Count</p>
                </article>
                <article class="rounded-xl border px-3 py-2" :class="autoReplyOn ? 'border-emerald-200 bg-emerald-50' : 'border-amber-200 bg-amber-50'">
                    <form method="post" action="/owner/leads/@Model.Id/pause">
                        @Html.AntiForgeryToken()
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <p class="text-[11px] font-semibold uppercase tracking-[0.12em]" :class="autoReplyOn ? 'text-emerald-700' : 'text-amber-700'">Automation</p>
                                <p class="mt-1 text-sm font-semibold" :class="autoReplyOn ? 'text-emerald-800' : 'text-amber-800'" x-text="autoReplyOn ? 'Auto-reply on' : 'Auto-reply off'"></p>
                            </div>
                            <label class="relative mt-0.5 inline-flex cursor-pointer items-center">
                                <input type="checkbox" class="peer sr-only" :checked="autoReplyOn" @@change="toggleAndSave($event)" />
                                <span class="h-6 w-11 rounded-full bg-slate-300 transition peer-checked:bg-indigo-600"></span>
                                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
                            </label>
                        </div>
                        <p class="mt-1 text-[11px] text-slate-500" x-show="statusMessage" x-text="statusMessage"></p>
                    </form>
                </article>
            </div>
        </div>
    </header>

    <section class="mb-3 rounded-2xl border border-indigo-200 bg-gradient-to-r from-indigo-50 via-sky-50 to-white px-4 py-4 shadow-panel sm:px-5">
        <div class="flex flex-wrap items-start gap-3">
            <div class="grid h-11 w-11 place-items-center rounded-xl bg-gradient-to-br from-indigo-600 to-sky-600 text-white shadow-sm">
                <i data-lucide="sparkles" class="h-5 w-5"></i>
            </div>
            <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-indigo-700">AI summary</p>
                <p class="mt-1 text-sm leading-6 text-slate-800">@(string.IsNullOrWhiteSpace(Model.ProjectSummary) ? "No summary yet." : Model.ProjectSummary)</p>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="mb-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@Model.Error</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Success))
    {
        <div
            x-data="{ show: true }"
            x-show="show"
            x-transition:enter="transition ease-out duration-250"
            x-transition:enter-start="opacity-0 translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-300"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 translate-y-1"
            x-init="setTimeout(() => show = false, 3200)"
            class="fixed right-4 top-[4.5rem] z-50 w-[min(24rem,calc(100vw-2rem))] rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 shadow-lg">
            <div class="flex items-start gap-2">
                <i data-lucide="check-circle" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-700"></i>
                <p class="font-medium">@Model.Success</p>
            </div>
        </div>
    }

    <div class="grid gap-3 xl:grid-cols-[340px_minmax(0,1.7fr)]">
        <aside class="order-1 space-y-3 xl:sticky xl:top-4 xl:self-start">
            <section class="rounded-xl border border-slate-200 bg-white p-3 shadow-panel" x-data="{ editing: false }">
                <div class="mb-2 flex items-center justify-between gap-2">
                    <h3 class="text-sm font-semibold text-slate-900">Contact profile</h3>
                    <button type="button" class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" @@click="editing = !editing">
                        <i data-lucide="pencil" class="h-3.5 w-3.5"></i>
                        <span x-text="editing ? 'Close' : 'Edit'"></span>
                    </button>
                </div>

                <div x-show="!editing" x-cloak>
                    <dl class="grid gap-2 text-sm">
                        <div class="grid grid-cols-[84px_1fr] gap-2"><dt class="text-slate-500">Name</dt><dd class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.Name) ? "-" : Model.Name)</dd></div>
                        <div class="grid grid-cols-[84px_1fr] gap-2"><dt class="text-slate-500">Email</dt><dd class="break-all font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</dd></div>
                        <div class="grid grid-cols-[84px_1fr] gap-2"><dt class="text-slate-500">Phone</dt><dd class="break-all font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</dd></div>
                    </dl>
                </div>

                <form x-show="editing" x-cloak method="post" action="/owner/leads/@Model.Id/contact" class="space-y-2.5">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="name">Name</label>
                        <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 ring-slate-200 outline-none focus:ring" id="name" name="name" type="text" value="@Model.Name" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="email">Email</label>
                        <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 ring-slate-200 outline-none focus:ring" id="email" name="email" type="email" value="@Model.Email" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="phone">Phone</label>
                        <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 ring-slate-200 outline-none focus:ring" id="phone" name="phone" type="tel" value="@Model.Phone" />
                    </div>
                    <button class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400" type="submit">Save contact</button>
                </form>
            </section>

            <section class="rounded-xl border border-slate-200 bg-white p-3 shadow-panel">
                <div class="mb-2">
                    <h3 class="text-sm font-semibold text-slate-900">Follow-up</h3>
                    <p class="text-xs text-slate-500">Private notes and your next action for this lead.</p>
                </div>
                <form method="post" action="/owner/leads/@Model.Id/follow-up" class="space-y-2.5">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="owner-notes">Notes</label>
                        <textarea id="owner-notes" name="ownerNotes" maxlength="4000" rows="4" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 ring-slate-200 outline-none focus:ring" placeholder="Add private context for this lead...">@Model.OwnerNotes</textarea>
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="next-action">Next action</label>
                        <input id="next-action" name="nextAction" maxlength="500" type="text" value="@Model.NextAction" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 ring-slate-200 outline-none focus:ring" placeholder="For example, send proposal" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="next-action-at">Due (UTC)</label>
                        <input id="next-action-at" name="nextActionAtUtc" type="datetime-local" value="@Model.NextActionAtInput" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 ring-slate-200 outline-none focus:ring" />
                        <p class="mt-1 text-xs text-slate-500">Leave blank if the next action has no due date.</p>
                    </div>
                    <button class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400" type="submit">Save follow-up</button>
                </form>
            </section>

            <section class="rounded-xl border border-slate-200 bg-white p-3 shadow-panel" x-data="{ editing: false }">
                <div class="mb-2 flex items-center justify-between gap-2">
                    <h3 class="text-sm font-semibold text-slate-900">Fields</h3>
                    <button type="button" class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" @@click="editing = !editing">
                        <i data-lucide="pencil" class="h-3.5 w-3.5"></i>
                        <span x-text="editing ? 'Close' : 'Edit'"></span>
                    </button>
                </div>

                <div x-show="!editing" x-cloak>
                    @if (!hasFields)
                    {
                        <p class="text-sm text-slate-500">No fields.</p>
                    }
                    else
                    {
                        <div class="max-h-[22rem] space-y-1 overflow-auto">
                            @foreach (var field in Model.FieldDefinitions)
                            {
                                <div class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-2">
                                    <p class="text-xs font-semibold text-slate-700">@field.Name</p>
                                    <p class="mt-0.5 text-sm text-slate-800">@(string.IsNullOrWhiteSpace(field.Value) ? "-" : field.Value)</p>
                                </div>
                            }
                        </div>
                    }
                </div>

                <form x-show="editing" x-cloak method="post" action="/owner/leads/@Model.Id/fields" class="space-y-2.5">
                    @Html.AntiForgeryToken()
                    @if (!hasFields)
                    {
                        <p class="text-sm text-slate-500">No fields.</p>
                    }
                    else
                    {
                        <div class="max-h-[22rem] space-y-2 overflow-auto pr-1">
                            @foreach (var field in Model.FieldDefinitions)
                            {
                                <div>
                                    <label class="mb-1 block text-sm font-semibold text-slate-700" for="fld_@field.Id">@field.Name</label>
                                    <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 ring-slate-200 outline-none focus:ring" id="fld_@field.Id" name="fields[@field.Id]" type="text" value="@field.Value" />
                                    @if (!string.IsNullOrWhiteSpace(field.Description))
                                    {
                                        <p class="mt-1 text-xs text-slate-500">@field.Description</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <button class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400" type="submit">Save fields</button>
                </form>
            </section>
        </aside>

        <main class="order-2 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
            <div class="border-b border-slate-100 px-4 py-3 sm:px-4">
                <h2 class="text-sm font-semibold text-slate-900">Activity timeline</h2>
                <p class="text-xs text-slate-500">Conversation history and CRM stage changes in one thread.</p>
            </div>

            @if (!hasActivity)
            {
                <div class="px-4 py-10 text-sm text-slate-500 sm:px-5">No activity yet.</div>
            }
            else
            {
                <div id="conversationTimeline" class="max-h-[38rem] space-y-2 overflow-auto bg-slate-50/60 px-4 py-3 sm:px-4">
                    @foreach (var activity in Model.Activity)
                    {
                        var isStage = string.Equals(activity.Kind, "stage", StringComparison.Ordinal);
                        var isIncoming = string.Equals(activity.Role, "user", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(activity.Role, "customer", StringComparison.OrdinalIgnoreCase);
                        var isOwner = string.Equals(activity.Role, "owner", StringComparison.OrdinalIgnoreCase);
                        var roleLabel = isStage ? "Stage change" : (isIncoming ? "Customer" : (isOwner ? "You" : "LeadRelay"));
                        var toneClass = isStage
                            ? "border-violet-200 bg-violet-50"
                            : (isIncoming ? "border-slate-200 bg-white" : (isOwner ? "border-indigo-200 bg-indigo-50" : "border-sky-200 bg-sky-50"));
                        var badgeClass = isStage
                            ? "bg-violet-100 text-violet-700"
                            : (isIncoming ? "bg-slate-100 text-slate-700" : (isOwner ? "bg-indigo-100 text-indigo-700" : "bg-sky-100 text-sky-700"));

                        <article class="rounded-xl border px-3 py-2.5 shadow-sm @toneClass">
                            <div class="mb-1 flex flex-wrap items-center gap-2">
                                <span class="inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-[0.08em] @badgeClass">@roleLabel</span>
                                <span class="text-[11px] font-medium text-slate-500">@activity.AtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</span>
                            </div>
                            <p class="whitespace-pre-wrap break-words text-sm leading-6 text-slate-800">@activity.Text</p>
                        </article>
                    }
                </div>
            }

            <div class="border-t border-slate-100 bg-white px-4 py-3 sm:px-4">
                <h3 class="text-sm font-semibold text-slate-900">Send message</h3>
                <p class="mt-1 text-xs text-slate-500">Choose a channel and send an outbound response.</p>

                <form method="post" action="/owner/leads/@Model.Id/reply" class="mt-3 space-y-3">
                    @Html.AntiForgeryToken()
                    <div class="grid gap-3 md:grid-cols-[220px_1fr]">
                        <div>
                            <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="replyChannel">Channel</label>
                            <select class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 ring-slate-200 outline-none focus:ring" id="replyChannel" name="replyChannel">
                                @if (Model.CanReplyViaWhatsApp)
                                {
                                    if (string.Equals(Model.ReplyChannel, "whatsapp", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="whatsapp" selected>WhatsApp</option>
                                    }
                                    else
                                    {
                                        <option value="whatsapp">WhatsApp</option>
                                    }
                                }
                                @if (Model.CanReplyViaEmail)
                                {
                                    if (string.Equals(Model.ReplyChannel, "email", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="email" selected>Email</option>
                                    }
                                    else
                                    {
                                        <option value="email">Email</option>
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="message">Message</label>
                            <textarea class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 ring-slate-200 outline-none focus:ring" id="message" name="message" rows="4" placeholder="Write your message to the customer..." required></textarea>
                            <p class="mt-1 text-xs text-slate-500">Available channels depend on lead contact details.</p>
                        </div>
                    </div>

                    <button class="inline-flex items-center gap-2 rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-700" type="submit">
                        <i data-lucide="send" class="h-4 w-4"></i>
                        <span>Send reply</span>
                    </button>
                </form>
            </div>
        </main>
    </div>
</div>

@section PageScripts {
<script>
    function leadWorkspace(initialPaused) {
        return {
            autoReplyOn: !initialPaused,
            statusMessage: "",
            async toggleAndSave(event) {
                const form = event?.target?.form;
                if (!(form instanceof HTMLFormElement)) {
                    this.statusMessage = "Could not update auto-reply state.";
                    return;
                }

                const previous = this.autoReplyOn;
                this.autoReplyOn = event.target.checked;
                this.statusMessage = "";
                const paused = !this.autoReplyOn;
                const formData = new FormData(form);
                formData.set("paused", paused ? "true" : "false");
                const body = new URLSearchParams(formData);

                const response = await fetch(form.action, {
                    method: "POST",
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    body,
                    credentials: "same-origin"
                });

                if (!response.ok) {
                    this.autoReplyOn = previous;
                    event.target.checked = this.autoReplyOn;
                    this.statusMessage = "Could not update auto-reply state.";
                    return;
                }

                try {
                    const data = await response.json();
                    if (typeof data.paused === "boolean") {
                        this.autoReplyOn = !data.paused;
                        event.target.checked = this.autoReplyOn;
                    }

                    if (typeof data.message === "string" && data.message.length > 0) {
                        this.statusMessage = data.message;
                    }
                } catch {
                    this.statusMessage = this.autoReplyOn ? "AI auto-reply is on." : "AI auto-reply is off.";
                }
            }
        };
    }

    (function () {
        var timeline = document.getElementById("conversationTimeline");
        if (!timeline) return;
        timeline.scrollTop = timeline.scrollHeight;
    })();
</script>
}
