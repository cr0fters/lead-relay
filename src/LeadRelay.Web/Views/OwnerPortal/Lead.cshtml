@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerLeadDetailModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lead Detail</title>
    <style>
        body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f6f8fc; color: #182438; }
        .wrap { max-width: 920px; margin: 0 auto; padding: 28px 20px 56px; }
        h1 { margin: 0 0 12px; }
        .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-bottom: 16px; }
        .card { background: #fff; border: 1px solid #d6e1f0; border-radius: 10px; padding: 12px; }
        .k { color: #5a6c84; font-size: 0.85rem; margin-bottom: 4px; }
        .error { border: 1px solid #efb4b4; background: #fff3f3; color: #a02222; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; }
        .success { border: 1px solid #b7e4c7; background: #f3fff7; color: #1f6c3a; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; }
        textarea { width: 100%; box-sizing: border-box; min-height: 110px; border: 1px solid #b4c3da; border-radius: 8px; padding: 10px; font: inherit; }
        button { border: none; border-radius: 8px; padding: 10px 12px; background: #0f62fe; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
        a { color: #0f62fe; text-decoration: none; }
        .conv { white-space: pre-wrap; line-height: 1.4; }
    </style>
</head>
<body>
<div class="wrap">
    <p><a href="/owner">← Back to leads</a></p>
    <h1>Lead @Model.Id</h1>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="error">@Model.Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Success))
    {
        <div class="success">@Model.Success</div>
    }

    <div class="row">
        <div class="card"><div class="k">Name</div><div>@(Model.Name ?? "-")</div></div>
        <div class="card"><div class="k">Email</div><div>@(Model.Email ?? "-")</div></div>
        <div class="card"><div class="k">Phone</div><div>@(Model.Phone ?? "-")</div></div>
        <div class="card"><div class="k">Created</div><div>@Model.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</div></div>
    </div>

    <div class="card" style="margin-bottom:16px;">
        <div class="k">Captured fields</div>
        @if (Model.Fields.Count == 0)
        {
            <div>-</div>
        }
        else
        {
            <ul>
                @foreach (var field in Model.Fields)
                {
                    <li><strong>@field.Key</strong>: @field.Value</li>
                }
            </ul>
        }
    </div>

    <div class="card" style="margin-bottom:16px;">
        <div class="k">Conversation</div>
        @if (Model.Conversation.Count == 0)
        {
            <div>-</div>
        }
        else
        {
            <div class="conv">
                @foreach (var turn in Model.Conversation)
                {
<text>[</text>@turn.AtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")<text>] </text>@turn.Role<text>: </text>@turn.Text<text>
</text>                }
            </div>
        }
    </div>

    <div class="card">
        <div class="k">Reply via WhatsApp</div>
        <form method="post" action="/owner/leads/@Model.Id/reply">
            @Html.AntiForgeryToken()
            <textarea name="message" placeholder="Type your reply..." required></textarea>
            <div style="margin-top:10px;">
                <button type="submit">Send reply</button>
            </div>
        </form>
    </div>
</div>
</body>
</html>
