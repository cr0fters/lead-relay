@model LeadRelay.Web.Controllers.OwnerPortalController.OwnerLeadDetailModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Lead workspace";
    var hasConversation = Model.Conversation.Count > 0;
    var hasFields = Model.FieldDefinitions.Count > 0;
}

<div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8" x-data>
    <header class="mb-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-100">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"><a class="hover:text-slate-700" href="/owner">Leads</a> / @Model.Id</p>
                <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900">Lead workspace</h1>
                <p class="text-sm text-slate-600">Owner: @Model.OwnerEmail · Created: @Model.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="/owner/settings" class="inline-flex items-center gap-2 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100">
                    <i data-lucide="settings-2" class="h-4 w-4"></i>
                    <span>Settings</span>
                </a>
                <form method="post" action="/owner/logout" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-100">
                        <i data-lucide="log-out" class="h-4 w-4"></i>
                        <span>Sign out</span>
                    </button>
                </form>
            </div>
        </div>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-xl bg-slate-50 px-3 py-2.5 ring-1 ring-slate-100">
                <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Name</p>
                <p class="mt-1 truncate text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Name) ? "-" : Model.Name)</p>
            </article>
            <article class="rounded-xl bg-slate-50 px-3 py-2.5 ring-1 ring-slate-100">
                <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Status</p>
                <p class="mt-1 text-sm font-semibold text-slate-900">@Model.Status</p>
            </article>
            <article class="rounded-xl bg-slate-50 px-3 py-2.5 ring-1 ring-slate-100">
                <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Channel</p>
                <p class="mt-1 text-sm font-semibold text-slate-900">@Model.Channel</p>
            </article>
            <article class="rounded-xl bg-slate-50 px-3 py-2.5 ring-1 ring-slate-100">
                <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Messages</p>
                <p class="mt-1 text-sm font-semibold text-slate-900">@Model.Conversation.Count</p>
            </article>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="mb-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@Model.Error</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Success))
    {
        <div class="mb-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@Model.Success</div>
    }

    <div class="grid gap-3 xl:grid-cols-[minmax(340px,1fr)_minmax(0,1.6fr)]">
        <main class="rounded-2xl bg-white shadow-sm ring-1 ring-slate-100 xl:order-2">
            <div class="border-b border-slate-100 px-4 py-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div>
                        <h2 class="text-sm font-semibold text-slate-900">Conversation</h2>
                        <p class="text-xs text-slate-500">Full timeline and outbound reply in one workspace.</p>
                    </div>
                    @if (!Model.IsPaused)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.08em] text-emerald-700">
                            <i data-lucide="bot" class="h-3.5 w-3.5"></i>
                            <span>Auto-reply on</span>
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.08em] text-amber-700">
                            <i data-lucide="pause-circle" class="h-3.5 w-3.5"></i>
                            <span>Auto-reply off</span>
                        </span>
                    }
                </div>
            </div>

            @if (!hasConversation)
            {
                <div class="px-4 py-10 text-sm text-slate-500">No messages yet.</div>
            }
            else
            {
                <div id="conversationTimeline" class="max-h-[32rem] space-y-2 overflow-auto bg-slate-50/60 px-4 py-3">
                    @foreach (var turn in Model.Conversation)
                    {
                        var isIncoming = string.Equals(turn.Role, "user", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(turn.Role, "customer", StringComparison.OrdinalIgnoreCase);
                        var roleLabel = isIncoming ? "Customer" : "LeadRelay";
                        <article class="max-w-[88%] @(isIncoming ? "mr-auto" : "ml-auto")">
                            <p class="mb-1 text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-500">@roleLabel · @turn.AtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</p>
                            <div class="rounded-xl px-3 py-2.5 text-sm leading-6 ring-1 @(isIncoming ? "bg-white text-slate-800 ring-slate-200" : "bg-sky-50 text-slate-800 ring-sky-100")">@turn.Text</div>
                        </article>
                    }
                </div>
            }

            <div class="border-t border-slate-100 bg-white px-4 py-3">
                <h3 class="mb-2 text-sm font-semibold text-slate-900">Reply</h3>
                <form method="post" action="/owner/leads/@Model.Id/reply" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <div class="grid gap-3 md:grid-cols-[220px_1fr]">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700" for="replyChannel">Send via</label>
                            <select class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="replyChannel" name="replyChannel">
                                @if (Model.CanReplyViaWhatsApp)
                                {
                                    if (string.Equals(Model.ReplyChannel, "whatsapp", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="whatsapp" selected>WhatsApp</option>
                                    }
                                    else
                                    {
                                        <option value="whatsapp">WhatsApp</option>
                                    }
                                }
                                @if (Model.CanReplyViaEmail)
                                {
                                    if (string.Equals(Model.ReplyChannel, "email", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="email" selected>Email</option>
                                    }
                                    else
                                    {
                                        <option value="email">Email</option>
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700" for="message">Message</label>
                            <textarea class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="message" name="message" rows="5" placeholder="Write your message to the customer..." required></textarea>
                            <p class="mt-1 text-xs text-slate-500">Use channel based on available contact details.</p>
                        </div>
                    </div>
                    <button class="inline-flex items-center gap-2 rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-700" type="submit">
                        <i data-lucide="send" class="h-4 w-4"></i>
                        <span>Send reply</span>
                    </button>
                </form>
            </div>
        </main>

        <aside class="space-y-3 xl:order-1" x-data="{ tab: 'overview' }">
            <section class="rounded-2xl bg-white p-3 shadow-sm ring-1 ring-slate-100">
                <div class="mb-3 flex flex-wrap gap-2">
                    <button type="button" class="rounded-md border px-3 py-1.5 text-sm font-semibold transition"
                            :class="tab === 'overview' ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50'"
                            @@click="tab = 'overview'">Overview</button>
                    <button type="button" class="rounded-md border px-3 py-1.5 text-sm font-semibold transition"
                            :class="tab === 'fields' ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50'"
                            @@click="tab = 'fields'">Captured fields</button>
                    <button type="button" class="rounded-md border px-3 py-1.5 text-sm font-semibold transition"
                            :class="tab === 'contact' ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50'"
                            @@click="tab = 'contact'">Edit contact</button>
                </div>

                <div x-show="tab === 'overview'" class="space-y-3">
                    <div class="rounded-xl bg-slate-50 p-3 ring-1 ring-slate-100">
                        <h2 class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Contact profile</h2>
                        <dl class="mt-2 grid gap-2 text-sm">
                            <div class="grid grid-cols-[100px_1fr] gap-2"><dt class="text-slate-500">Name</dt><dd class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.Name) ? "-" : Model.Name)</dd></div>
                            <div class="grid grid-cols-[100px_1fr] gap-2"><dt class="text-slate-500">Email</dt><dd class="break-all font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</dd></div>
                            <div class="grid grid-cols-[100px_1fr] gap-2"><dt class="text-slate-500">Phone</dt><dd class="break-all font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</dd></div>
                        </dl>
                    </div>

                    <div class="rounded-xl bg-indigo-50 p-3 ring-1 ring-indigo-100">
                        <div class="mb-2 flex items-center gap-2 text-slate-700">
                            <i data-lucide="sparkles" class="h-4 w-4 text-indigo-600"></i>
                            <h2 class="text-xs font-semibold uppercase tracking-[0.12em] text-indigo-700">AI summary</h2>
                        </div>
                        <p class="rounded-lg bg-white p-3 text-sm leading-6 text-slate-700 ring-1 ring-indigo-100">@(string.IsNullOrWhiteSpace(Model.ProjectSummary) ? "No summary yet." : Model.ProjectSummary)</p>
                    </div>

                    <div class="rounded-xl bg-slate-50 p-3 ring-1 ring-slate-100">
                        <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Conversation control</h2>
                        <form method="post" action="/owner/leads/@Model.Id/pause" x-data="pauseToggle(@(Model.IsPaused ? "true" : "false"))">
                            @Html.AntiForgeryToken()
                            <div class="flex items-center justify-between rounded-lg bg-white px-3 py-2 ring-1 ring-slate-200">
                                <div>
                                    <p class="text-sm font-semibold text-slate-800">AI auto-reply</p>
                                    <p class="text-xs text-slate-500" x-text="autoReplyOn ? 'On' : 'Off'"></p>
                                </div>
                                <label class="relative inline-flex cursor-pointer items-center">
                                    <input type="checkbox" class="peer sr-only" :checked="autoReplyOn" @@change="toggleAndSave($event)" />
                                    <span class="h-6 w-11 rounded-full bg-slate-300 transition peer-checked:bg-indigo-600"></span>
                                    <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
                                </label>
                            </div>
                            <p class="mt-2 text-xs text-slate-500" x-show="statusMessage" x-text="statusMessage"></p>
                        </form>
                    </div>
                </div>

                <div x-show="tab === 'fields'" class="space-y-3">
                    <form method="post" action="/owner/leads/@Model.Id/fields" class="space-y-3">
                        @Html.AntiForgeryToken()
                        @if (!hasFields)
                        {
                            <div class="rounded-lg bg-slate-50 p-3 text-sm text-slate-500 ring-1 ring-slate-100">No captured fields.</div>
                        }
                        else
                        {
                            foreach (var field in Model.FieldDefinitions)
                            {
                                <div class="rounded-lg bg-slate-50 p-3 ring-1 ring-slate-100">
                                    <label class="mb-1 block text-sm font-semibold text-slate-700" for="fld_@field.Id">@field.Name</label>
                                    <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="fld_@field.Id" name="fields[@field.Id]" type="text" value="@field.Value" />
                                    @if (!string.IsNullOrWhiteSpace(field.Description))
                                    {
                                        <p class="mt-1 text-xs text-slate-500">@field.Description</p>
                                    }
                                </div>
                            }
                        }
                        <button class="w-full rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400" type="submit">Save fields</button>
                    </form>
                </div>

                <div x-show="tab === 'contact'" class="space-y-3">
                    <form method="post" action="/owner/leads/@Model.Id/contact" class="space-y-3">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700" for="name">Name</label>
                            <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="name" name="name" type="text" value="@Model.Name" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700" for="email">Email</label>
                            <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="email" name="email" type="email" value="@Model.Email" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700" for="phone">Phone</label>
                            <input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm ring-slate-200 outline-none focus:ring" id="phone" name="phone" type="tel" value="@Model.Phone" />
                        </div>
                        <button class="w-full rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400" type="submit">Save contact</button>
                    </form>
                </div>
            </section>
        </aside>
    </div>
</div>

@section PageScripts {
<script>
    function pauseToggle(initialPaused) {
        return {
            autoReplyOn: !initialPaused,
            statusMessage: "",
            async toggleAndSave(event) {
                const form = event?.target?.form;
                if (!(form instanceof HTMLFormElement)) {
                    this.statusMessage = "Could not update auto-reply state.";
                    return;
                }

                const previous = this.autoReplyOn;
                this.autoReplyOn = event.target.checked;
                this.statusMessage = "";
                const paused = !this.autoReplyOn;
                const formData = new FormData(form);
                formData.set("paused", paused ? "true" : "false");
                const body = new URLSearchParams(formData);
                const response = await fetch(form.action, {
                    method: "POST",
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    body,
                    credentials: "same-origin"
                });

                if (!response.ok) {
                    this.autoReplyOn = previous;
                    event.target.checked = this.autoReplyOn;
                    this.statusMessage = "Could not update auto-reply state.";
                    return;
                }

                try {
                    const data = await response.json();
                    if (typeof data.paused === "boolean") {
                        this.autoReplyOn = !data.paused;
                        event.target.checked = this.autoReplyOn;
                    }

                    if (typeof data.message === "string" && data.message.length > 0) {
                        this.statusMessage = data.message;
                    }
                } catch {
                    this.statusMessage = this.autoReplyOn ? "AI auto-reply is on." : "AI auto-reply is off.";
                }
            }
        };
    }

    (function () {
        var timeline = document.getElementById("conversationTimeline");
        if (!timeline) return;
        timeline.scrollTop = timeline.scrollHeight;
    })();
</script>
}
