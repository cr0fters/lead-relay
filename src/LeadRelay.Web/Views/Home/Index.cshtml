@{ Layout = "~/Views/Shared/_MarketingLayout.cshtml"; }

@section Head {
<style>
    .landing {
        display: grid;
        gap: 72px;
        padding-bottom: 24px;
    }

    .full-bleed {
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        padding-left: calc(50vw - min(560px, 50vw - 16px));
        padding-right: calc(50vw - min(560px, 50vw - 16px));
    }

    .hero {
        text-align: center;
        padding-top: 36px;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border: 1px solid #b8e7db;
        background: #e9fbf5;
        color: #0f766e;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }

    .eyebrow img {
        width: 17px;
        height: 17px;
    }

    .hero h1 {
        margin: 16px auto 12px;
        max-width: 14ch;
        font-family: "Manrope", sans-serif;
        font-size: clamp(2.2rem, 6vw, 4.15rem);
        line-height: 1.02;
        letter-spacing: -0.02em;
    }

    .hero h1 .accent {
        color: #059669;
    }

    .hero p {
        margin: 0 auto;
        max-width: 60ch;
        font-size: 1.04rem;
        color: #526077;
    }

    .hero-cta {
        margin-top: 24px;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .hero-stats {
        margin: 38px auto 0;
        width: min(840px, 100%);
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid #dfe5ef;
        padding-top: 22px;
    }

    .metric {
        text-align: center;
        border-right: 1px solid #e5eaf2;
    }

    .metric:last-child { border-right: none; }

    .metric strong {
        display: block;
        font-family: "Manrope", sans-serif;
        font-size: clamp(1.45rem, 2.5vw, 2rem);
        line-height: 1.1;
    }

    .metric span {
        display: block;
        margin-top: 4px;
        color: #64748b;
        font-size: 0.86rem;
    }

    .mint-band {
        background:
            radial-gradient(440px 260px at 10% 10%, rgba(16, 185, 129, 0.16), transparent 70%),
            radial-gradient(420px 240px at 85% 84%, rgba(6, 182, 212, 0.12), transparent 72%),
            #edf8f4;
        border-top: 1px solid #d4e9e2;
        border-bottom: 1px solid #d4e9e2;
        padding-top: 68px;
        padding-bottom: 68px;
    }

    .section-head {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 26px;
    }

    .section-head h2 {
        margin: 0;
        font-family: "Manrope", sans-serif;
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        line-height: 1.06;
    }

    .section-head h2 .accent { color: #059669; }

    .section-head p {
        margin: 12px auto 0;
        color: #526077;
        max-width: 60ch;
    }

    .steps-wrap {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .step-card {
        border: 1px solid #dbe4f0;
        border-radius: 10px;
        background: #fff;
        padding: 16px;
    }

    .step-index {
        display: inline-flex;
        width: 30px;
        height: 30px;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #e9fbf5;
        color: #047857;
        font-weight: 700;
        font-size: 0.88rem;
    }

    .step-card h3 {
        margin: 12px 0 8px;
        font-size: 1.03rem;
        font-family: "Manrope", sans-serif;
    }

    .step-card p {
        margin: 0;
        color: #526077;
        line-height: 1.5;
    }

    .flow-demo {
        min-height: 112px;
        margin-top: 14px;
        padding: 10px;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        background: #f8fafc;
        display: grid;
        align-content: center;
        gap: 7px;
    }

    .wa-button {
        display: inline-flex;
        align-items: center;
        justify-self: center;
        gap: 8px;
        border-radius: 999px;
        background: #25d366;
        color: #052e1a;
        padding: 9px 13px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .wa-button img {
        width: 22px;
        height: 22px;
    }

    .chat-bubble {
        max-width: 88%;
        border-radius: 9px 9px 9px 3px;
        background: #fff;
        border: 1px solid #e2e8f0;
        padding: 7px 9px;
        font-size: 0.72rem;
        color: #334155;
    }

    .chat-bubble.reply {
        justify-self: end;
        border-radius: 9px 9px 3px 9px;
        background: #dcfce7;
        border-color: #bbf7d0;
    }

    .inbox-row,
    .timeline-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        padding: 7px 8px;
        border-radius: 7px;
        background: #fff;
        border: 1px solid #e2e8f0;
        font-size: 0.7rem;
        color: #334155;
    }

    .inbox-row strong,
    .timeline-row strong { color: #0f172a; }

    .new-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        flex: 0 0 8px;
        margin-top: 3px;
        border-radius: 999px;
        background: #7c3aed;
    }

    .feature-grid,
    .requirements-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .feature-card,
    .requirement-card {
        background: #fff;
        border: 1px solid #d5e9e2;
        border-radius: 10px;
        padding: 16px;
    }

    .feature-card strong,
    .requirement-card strong {
        display: block;
        font-family: "Manrope", sans-serif;
    }

    .feature-card p,
    .requirement-card p {
        margin: 8px 0 0;
        color: #526077;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .feature-label {
        display: inline-flex;
        margin-bottom: 10px;
        color: #047857;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .requirements-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    .brand-note {
        margin: 14px auto 0;
        max-width: 70ch;
        color: #64748b;
        font-size: 0.78rem;
        text-align: center;
    }

    .cta-band {
        background: #059669;
        border-top: 1px solid #047857;
        border-bottom: 1px solid #047857;
        color: #ecfdf5;
        padding-top: 18px;
        padding-bottom: 18px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 14px;
        align-items: center;
    }

    .cta-band p {
        margin: 0;
        color: #d1fae5;
    }

    .crm-band {
        background:
            radial-gradient(420px 260px at 12% 20%, rgba(16, 185, 129, 0.17), transparent 70%),
            #edf8f4;
        border-top: 1px solid #d4e9e2;
        border-bottom: 1px solid #d4e9e2;
        padding-top: 68px;
        padding-bottom: 68px;
    }

    .crm-grid {
        display: grid;
        gap: 28px;
        grid-template-columns: 1fr 1fr;
        align-items: center;
    }

    .crm-copy h2 {
        margin: 0;
        font-family: "Manrope", sans-serif;
        font-size: clamp(1.7rem, 4vw, 2.7rem);
        line-height: 1.08;
    }

    .crm-copy h2 .accent { color: #059669; }

    .crm-copy p {
        margin: 12px 0 0;
        color: #526077;
        line-height: 1.58;
    }

    .crm-list {
        margin: 16px 0 0;
        padding-left: 18px;
        color: #334155;
        display: grid;
        gap: 6px;
    }

    .crm-mock {
        border: 1px solid #d9e3ef;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 16px 34px rgba(15, 23, 42, 0.12);
        padding: 18px;
        display: grid;
        gap: 12px;
    }

    .mock-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
    }

    .mock-chip {
        padding: 4px 8px;
        border-radius: 999px;
        background: #e9fbf5;
        color: #047857;
        font-size: 0.76rem;
        font-weight: 700;
    }

    .mock-item {
        border: 1px solid #e5eaf2;
        border-radius: 8px;
        padding: 10px;
    }

    .mock-item strong {
        display: block;
        font-size: 0.88rem;
    }

    .mock-item span {
        color: #64748b;
        font-size: 0.84rem;
    }

    .faq-grid {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 20px;
        align-items: start;
    }

    .faq-lead h2 {
        margin: 0;
        font-family: "Manrope", sans-serif;
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        line-height: 1.1;
    }

    .faq-lead p {
        margin: 10px 0 0;
        color: #526077;
    }

    .faq-list {
        display: grid;
        gap: 0;
        background: #fff;
        border: 1px solid #dbe4f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .faq-item {
        padding: 14px 16px;
        border-bottom: 1px solid #e5eaf2;
    }

    .faq-item:last-child { border-bottom: none; }

    .faq-item h3 {
        margin: 0;
        font-size: 0.98rem;
        font-family: "Manrope", sans-serif;
    }

    .faq-item p {
        margin: 7px 0 0;
        color: #526077;
        font-size: 0.9rem;
    }

    .security {
        padding-top: 12px;
    }

    .security-grid {
        margin-top: 20px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .security-card {
        border: 1px solid #d5e9e2;
        border-radius: 10px;
        background: #fff;
        padding: 14px;
    }

    .security-card h3 {
        margin: 0;
        font-size: 0.95rem;
        font-family: "Manrope", sans-serif;
    }

    .security-card p {
        margin: 7px 0 0;
        color: #526077;
        font-size: 0.86rem;
    }

    @@media (max-width: 980px) {
        .hero-stats { grid-template-columns: 1fr 1fr; row-gap: 18px; }
        .metric { border-right: none; }
        .steps-wrap { grid-template-columns: 1fr; }
        .feature-grid { grid-template-columns: 1fr 1fr; }
        .requirements-grid { grid-template-columns: 1fr; }
        .crm-grid { grid-template-columns: 1fr; }
        .faq-grid { grid-template-columns: 1fr; }
        .security-grid { grid-template-columns: 1fr 1fr; }
    }

    @@media (max-width: 640px) {
        .landing { gap: 56px; }
        .hero { padding-top: 16px; }
        .hero-stats { grid-template-columns: 1fr; gap: 16px; }
        .feature-grid { grid-template-columns: 1fr; }
        .security-grid { grid-template-columns: 1fr; }
        .cta-band { grid-template-columns: 1fr; }
        .full-bleed {
            padding-left: 12px;
            padding-right: 12px;
        }
    }
</style>
}

<div class="landing">
    <section class="hero" id="product">
        <span class="eyebrow"><img src="/widget/whatsapp-green.svg" alt="" /> WhatsApp lead qualification + CRM</span>
        <h1>Turn WhatsApp enquiries into <span class="accent">structured leads</span></h1>
        <p>
            Add a familiar WhatsApp button to your website. LeadRelay asks your qualification questions,
            organizes each enquiry in a lightweight CRM, and gives you the context to follow up.
        </p>
        <div class="hero-cta">
            <a class="btn btn-primary" href="/owner/register">Create your account</a>
            <a class="btn btn-secondary" href="#how-it-works">See how it works</a>
            <a class="btn btn-secondary" href="/owner/login">Sign in</a>
        </div>

        <div class="hero-stats">
            <div class="metric"><strong>1 click</strong><span>Visitor opens WhatsApp</span></div>
            <div class="metric"><strong>Your fields</strong><span>Custom qualification</span></div>
            <div class="metric"><strong>1 inbox</strong><span>Leads and replies</span></div>
            <div class="metric"><strong>5 stages</strong><span>New through won or lost</span></div>
        </div>
    </section>

    <section class="mint-band full-bleed" aria-label="LeadRelay capabilities">
        <div class="section-head">
            <h2>One focused workflow from <span class="accent">click to close</span></h2>
            <p>Concrete tools for capturing, understanding, organizing, and converting WhatsApp enquiries.</p>
        </div>

        <div class="feature-grid">
            <article class="feature-card">
                <span class="feature-label">Capture</span>
                <strong>Website click-to-WhatsApp</strong>
                <p>A recognizable button opens a conversation with your connected WhatsApp business number.</p>
            </article>
            <article class="feature-card">
                <span class="feature-label">Qualify</span>
                <strong>Questions shaped by you</strong>
                <p>Capture budget, timeline, scope, and the other details your business actually needs.</p>
            </article>
            <article class="feature-card">
                <span class="feature-label">Organize</span>
                <strong>Structured CRM records</strong>
                <p>See contact details, qualification answers, summaries, and conversation history together.</p>
            </article>
            <article class="feature-card">
                <span class="feature-label">Convert</span>
                <strong>Human follow-up</strong>
                <p>Take over, reply, add private notes and next actions, then track the lead through five stages.</p>
            </article>
        </div>
    </section>

    <section id="how-it-works">
        <div class="section-head">
            <h2>See the complete <span class="accent">lead journey</span></h2>
            <p>The WhatsApp entry point is only the beginning. LeadRelay turns the conversation into usable CRM work.</p>
        </div>

        <div class="steps-wrap">
            <article class="step-card">
                <span class="step-index">1</span>
                <h3>A visitor taps WhatsApp</h3>
                <p>Your website snippet presents a familiar click-to-chat action.</p>
                <div class="flow-demo">
                    <span class="wa-button"><img src="/widget/whatsapp-white.svg" alt="" /> Chat on WhatsApp</span>
                </div>
            </article>
            <article class="step-card">
                <span class="step-index">2</span>
                <h3>LeadRelay qualifies</h3>
                <p>The conversation gathers the custom details you configured.</p>
                <div class="flow-demo" aria-label="Qualification conversation preview">
                    <span class="chat-bubble">What would you like help with?</span>
                    <span class="chat-bubble reply">A kitchen renovation.</span>
                    <span class="chat-bubble">What budget range are you considering?</span>
                </div>
            </article>
            <article class="step-card">
                <span class="step-index">3</span>
                <h3>A structured lead appears</h3>
                <p>The CRM highlights the new enquiry and sends the owner an email notification.</p>
                <div class="flow-demo" aria-label="Lead inbox preview">
                    <span class="inbox-row"><span><span class="new-dot"></span> Maya · Kitchen project</span><strong>New</strong></span>
                    <span class="inbox-row"><span>Sam · Extension</span><strong>Qualified</strong></span>
                </div>
            </article>
            <article class="step-card">
                <span class="step-index">4</span>
                <h3>You follow up and track it</h3>
                <p>Review the timeline, reply, save notes and a next action, and update the outcome.</p>
                <div class="flow-demo" aria-label="Lead detail timeline preview">
                    <span class="timeline-row"><span>Qualification completed</span><strong>09:42</strong></span>
                    <span class="timeline-row"><span>New → Qualified</span><strong>10:06</strong></span>
                    <span class="timeline-row"><span>Next: consultation call</span><strong>Thu</strong></span>
                </div>
            </article>
        </div>
        <p class="brand-note">WhatsApp is a trademark of Meta Platforms, Inc. LeadRelay is an independent product and is not endorsed by or affiliated with Meta.</p>
    </section>

    <section class="cta-band full-bleed">
        <div>
            <strong>Bring your website enquiries into one working inbox</strong>
            <p>Create an account, configure your qualification fields, and connect your WhatsApp business setup.</p>
        </div>
        <a class="btn btn-primary" href="/owner/register" style="background:#0f172a;">Start setup</a>
    </section>

    <section class="crm-band full-bleed">
        <div class="crm-grid">
            <div class="crm-copy">
                <h2>A lightweight CRM built for <span class="accent">WhatsApp leads</span></h2>
                <p>
                    Every qualified chat lands in one place. Review lead details, continue the conversation,
                    and track outcomes without switching tools.
                </p>
                <ul class="crm-list">
                    <li>See qualification answers and chat history together</li>
                    <li>Reply over available WhatsApp or email channels</li>
                    <li>Search, filter, export, add notes, and plan the next action</li>
                    <li>Move each opportunity from New to Qualified, Contacted, Won, or Lost</li>
                </ul>
            </div>

            <article class="crm-mock" aria-label="CRM preview">
                <div class="mock-top">
                    <strong>Kitchen renovation inquiry</strong>
                    <span class="mock-chip">Qualified</span>
                </div>
                <div class="mock-item">
                    <strong>Budget</strong>
                    <span>£45,000</span>
                </div>
                <div class="mock-item">
                    <strong>Timeline</strong>
                    <span>Start in April</span>
                </div>
                <div class="mock-item">
                    <strong>Next action</strong>
                    <span>Book consultation call</span>
                </div>
                <a class="btn btn-secondary" href="/owner/login">Sign in to CRM</a>
            </article>
        </div>
    </section>

    <section id="what-you-need">
        <div class="section-head">
            <h2>What you need to <span class="accent">get set up</span></h2>
            <p>LeadRelay removes CRM busywork, but it cannot remove the provider and website steps that make WhatsApp work.</p>
        </div>
        <div class="requirements-grid">
            <article class="requirement-card">
                <strong>A WhatsApp business setup</strong>
                <p>You will connect a business number through Meta and complete any verification Meta requires.</p>
            </article>
            <article class="requirement-card">
                <strong>Access to your website</strong>
                <p>You or your site builder will add a small script snippet and configure the allowed domain.</p>
            </article>
            <article class="requirement-card">
                <strong>Your qualification questions</strong>
                <p>Tell LeadRelay what matters—such as service, scope, budget, location, and timeline.</p>
            </article>
        </div>
    </section>

    <section id="faq">
        <div class="faq-grid">
            <div class="faq-lead">
                <h2>Frequently asked questions</h2>
                <p>Everything you need to launch your WhatsApp qualification flow confidently.</p>
            </div>

            <div class="faq-list">
                <article class="faq-item">
                    <h3>Can I customize the qualification questions?</h3>
                    <p>Yes. Add and edit your lead fields at any time, and AI will use the latest setup.</p>
                </article>
                <article class="faq-item">
                    <h3>Do I need engineering support to set this up?</h3>
                    <p>You need access to your Meta business setup and the ability to add a script snippet to your website. LeadRelay guides the product configuration, but those external steps may require your site administrator.</p>
                </article>
                <article class="faq-item">
                    <h3>Can I still reply manually?</h3>
                    <p>Yes. LeadRelay qualifies the lead, then the account owner can pause automation and take over from the integrated inbox.</p>
                </article>
                <article class="faq-item">
                    <h3>Where can I review legal and data policies?</h3>
                    <p>Privacy policy, terms and conditions, and user data deletion are available in the footer.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="mint-band full-bleed security" aria-label="Security details">
        <div class="section-head">
            <h2>Clear controls around your lead data</h2>
            <p>LeadRelay keeps the one-owner MVP focused on tenant-scoped access, practical data controls, and visible lead context.</p>
        </div>

        <div class="security-grid">
            <article class="security-card">
                <h3>Access controls</h3>
                <p>The MVP uses one owner account per workspace, with tenant-scoped lead access.</p>
            </article>
            <article class="security-card">
                <h3>Data controls</h3>
                <p>Edit lead details and export core CRM and qualification data from the inbox.</p>
            </article>
            <article class="security-card">
                <h3>Activity context</h3>
                <p>Review conversation history and CRM stage changes in one lead timeline.</p>
            </article>
            <article class="security-card">
                <h3>Policy transparency</h3>
                <p>Clear policy documents linked directly in the footer.</p>
            </article>
        </div>
    </section>
</div>
