@model LeadRelay.Web.Controllers.OwnerOnboardingController.OwnerOnboardingModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Setup";
    var connected = Model.Connection.IsConnected;
    var hasDomain = Model.AllowedDomains.Count > 0;
}

@section HeadScripts {
    @if (Model.IsEmbeddedSignupAvailable)
    {
        <script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js"></script>
    }
}

<div class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
    <header class="mb-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-panel">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-700">Guided setup</p>
                <h1 class="mt-1 font-display text-3xl font-semibold tracking-tight text-slate-900">Get @Model.SiteName ready for leads</h1>
                <p class="mt-2 text-sm text-slate-600">Complete each step now or return later. Your workspace remains available throughout.</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-right">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Progress</p>
                <p class="font-display text-2xl font-semibold text-slate-900">@Model.CompletedSteps / 5</p>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">@Model.Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Success))
    {
        <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@Model.Success</div>
    }

    <div class="grid gap-4 lg:grid-cols-[0.8fr_1.2fr]">
        <aside class="space-y-2 rounded-2xl border border-slate-200 bg-white p-4 shadow-panel">
            @foreach (var item in new[]
            {
                ("Account verified", Model.IsEmailVerified),
                ("WhatsApp connected and tested", Model.IsWhatsAppReady),
                ("Website widget installed and tested", Model.IsWidgetInstalled),
                ("Subscription/trial active", Model.IsSubscriptionActive),
                ("First lead captured", Model.HasFirstLead)
            })
            {
                <div class="flex items-center gap-3 rounded-xl border px-3 py-2.5 @(item.Item2 ? "border-emerald-200 bg-emerald-50" : "border-slate-200 bg-slate-50")">
                    <span class="inline-flex h-7 w-7 items-center justify-center rounded-full @(item.Item2 ? "bg-emerald-600 text-white" : "bg-slate-200 text-slate-500")">
                        <i data-lucide="@(item.Item2 ? "check" : "circle")" class="h-4 w-4"></i>
                    </span>
                    <span class="text-sm font-semibold @(item.Item2 ? "text-emerald-900" : "text-slate-600")">@item.Item1</span>
                </div>
            }
        </aside>

        <main class="space-y-4">
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-panel">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Step 1</p>
                        <h2 class="font-display text-xl font-semibold text-slate-900">Review your lead setup</h2>
                        <p class="mt-1 text-sm text-slate-600">Check your business profile, WhatsApp greeting, and the questions LeadRelay asks.</p>
                    </div>
                    <a href="/owner/settings" class="inline-flex items-center gap-2 rounded-lg border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100">
                        Review settings
                        <i data-lucide="arrow-right" class="h-4 w-4"></i>
                    </a>
                </div>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-panel">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Step 2</p>
                        <h2 class="font-display text-xl font-semibold text-slate-900">Connect WhatsApp</h2>
                    </div>
                    <span class="rounded-full px-3 py-1 text-xs font-semibold @(connected ? "bg-emerald-100 text-emerald-800" : Model.Connection.Exists ? "bg-amber-100 text-amber-800" : "bg-slate-100 text-slate-600")">
                        @(connected ? "Connected" : Model.Connection.Exists ? "Action required" : "Not connected")
                    </span>
                </div>

                @if (connected)
                {
                    <dl class="mt-4 grid gap-3 rounded-xl bg-slate-50 p-4 text-sm sm:grid-cols-2">
                        <div><dt class="text-slate-500">Display number</dt><dd class="font-semibold text-slate-900">@Model.Connection.DisplayPhoneNumber</dd></div>
                        <div><dt class="text-slate-500">Last validated</dt><dd class="font-semibold text-slate-900">@(Model.Connection.LastValidatedAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Not available")</dd></div>
                        <div><dt class="text-slate-500">App subscription</dt><dd class="font-semibold text-slate-900">@(Model.Connection.IsWebhookSubscribed ? "Accepted by Meta" : "Not confirmed")</dd></div>
                        <div><dt class="text-slate-500">Webhook delivery</dt><dd class="font-semibold @(Model.Connection.IsWebhookVerified ? "text-emerald-700" : "text-amber-700")">@(Model.Connection.IsWebhookVerified ? "Verified by inbound message" : "Awaiting inbound message")</dd></div>
                    </dl>
                }
                else if (Model.IsEmbeddedSignupAvailable)
                {
                    <div class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4">
                        <p class="font-semibold text-emerald-950">Keep using your WhatsApp Business App</p>
                        <p class="mt-1 text-sm text-emerald-900">Meta will guide you through connecting an eligible existing Business App number to LeadRelay. You will sign in with Meta and approve the connection; LeadRelay never asks you to paste an access token.</p>
                        <button id="connectWhatsAppButton" type="button" class="mt-4 inline-flex items-center justify-center gap-2 rounded-lg bg-[#1877F2] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#166fe5] disabled:cursor-wait disabled:opacity-60">
                            Connect with Meta
                            <i data-lucide="external-link" class="h-4 w-4"></i>
                        </button>
                        <p id="embeddedSignupStatus" class="mt-3 text-sm text-emerald-900" role="status" aria-live="polite"></p>
                    </div>
                }
                else
                {
                    <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                        WhatsApp connection is temporarily unavailable while the Meta Embedded Signup configuration is completed. You can continue reviewing your settings and return here later.
                    </div>
                }

                @if (Model.IsEmbeddedSignupAvailable)
                {
                    <form id="embeddedSignupForm"
                          method="post"
                          action="/owner/onboarding/whatsapp/embedded-signup/complete"
                          class="hidden"
                          data-ajax="off"
                          data-app-id="@Model.MetaAppId"
                          data-configuration-id="@Model.EmbeddedSignupConfigurationId"
                          data-signup-version="@Model.EmbeddedSignupVersion"
                          data-graph-version="@Model.GraphApiVersion">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="authorizationCode" />
                        <input type="hidden" name="wabaId" />
                        <input type="hidden" name="phoneNumberId" />
                    </form>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Connection.LastError))
                {
                    <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">@Model.Connection.LastError</p>
                }

                @if (connected)
                {
                    <div class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto]">
                        <form method="post" action="/owner/onboarding/whatsapp/test" class="flex gap-2" data-ajax="off">
                            @Html.AntiForgeryToken()
                            <input name="recipient" required inputmode="tel" placeholder="Test recipient with country code" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" />
                            <button class="rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" type="submit">Send test</button>
                        </form>
                        <form method="post" action="/owner/onboarding/whatsapp/disconnect" data-ajax="off" onsubmit="return confirm('Disconnect WhatsApp and remove the stored credential?');">
                            @Html.AntiForgeryToken()
                            <button class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100" type="submit">Disconnect</button>
                        </form>
                    </div>
                    @if (Model.IsEmbeddedSignupAvailable)
                    {
                        <button id="connectWhatsAppButton" type="button" class="mt-3 inline-flex items-center gap-2 rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100 disabled:cursor-wait disabled:opacity-60">
                            Reconnect with Meta
                            <i data-lucide="refresh-cw" class="h-4 w-4"></i>
                        </button>
                        <p id="embeddedSignupStatus" class="mt-2 text-sm text-slate-600" role="status" aria-live="polite"></p>
                    }
                    <p class="mt-2 text-xs text-slate-500">The recipient must be eligible to receive a free-form message. Reply from that number to verify inbound capture; its conversations are labelled as tests and do not count as your first real lead. If the outbound test is rejected, message the business number first and retry.</p>
                }
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-panel">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Step 3</p>
                        <h2 class="font-display text-xl font-semibold text-slate-900">Install and test the website widget</h2>
                    </div>
                    <span class="rounded-full px-3 py-1 text-xs font-semibold @(Model.IsWidgetInstalled ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-600")">
                        @(Model.IsWidgetInstalled ? "Detected on your website" : "Waiting for installation")
                    </span>
                </div>
                <form method="post" action="/owner/onboarding/domain" class="mt-4 flex gap-2" data-ajax="off">
                    @Html.AntiForgeryToken()
                    <input name="domain" value="@(Model.AllowedDomains.FirstOrDefault())" required placeholder="example.com" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" />
                    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" type="submit">Save domain</button>
                </form>
                @if (hasDomain)
                {
                    <p class="mt-3 text-xs text-slate-500">Configured domains: @string.Join(", ", Model.AllowedDomains)</p>
                    <p class="mt-4 text-sm font-semibold text-slate-700">Paste this before the closing <code>&lt;/body&gt;</code> tag:</p>
                    <pre class="mt-2 overflow-x-auto rounded-xl bg-slate-950 p-4 text-xs text-slate-100"><code>@Model.WidgetSnippet</code></pre>
                    <textarea id="onboardingWidgetSnippet" class="sr-only" readonly aria-hidden="true">@Model.WidgetSnippet</textarea>
                    <button type="button" class="mt-2 inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" onclick="navigator.clipboard.writeText(document.getElementById('onboardingWidgetSnippet').value)">
                        <i data-lucide="copy" class="h-4 w-4"></i>
                        Copy snippet
                    </button>

                    <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
                        <div class="flex items-center gap-1.5 border-b border-slate-200 bg-white px-3 py-2" aria-hidden="true">
                            <span class="h-2.5 w-2.5 rounded-full bg-rose-300"></span><span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span><span class="h-2.5 w-2.5 rounded-full bg-emerald-300"></span>
                            <span class="ml-2 text-xs text-slate-400">Your website preview</span>
                        </div>
                        <div class="relative min-h-52 bg-gradient-to-br from-white to-slate-100 p-6">
                            <div class="h-4 w-40 rounded bg-slate-300"></div>
                            <div class="mt-3 h-2.5 w-64 max-w-[70%] rounded bg-slate-200"></div>
                            <div class="mt-2 h-2.5 w-52 max-w-[60%] rounded bg-slate-200"></div>
                            @if (!string.IsNullOrWhiteSpace(Model.WhatsAppPreviewUrl))
                            {
                                <a href="@Model.WhatsAppPreviewUrl" target="_blank" rel="noopener noreferrer" class="absolute bottom-5 right-5 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5" aria-label="Open the WhatsApp widget test">
                                    <img src="/widget/whatsapp-white.svg" alt="" class="h-5 w-5" />
                                    Chat via WhatsApp
                                </a>
                            }
                        </div>
                    </div>

                    <div class="mt-4 rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900">
                        <p class="font-semibold">Test the real journey</p>
                        <ol class="mt-2 list-decimal space-y-1 pl-5">
                            <li>Publish the snippet, then visit the configured website in a new tab.</li>
                            <li>Confirm the green WhatsApp button appears. That successful load automatically completes the website step here.</li>
                            <li>Click it and send the message from the same number used for your WhatsApp setup test so the conversation remains labelled as a test.</li>
                        </ol>
                    </div>

                    <details class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
                        <summary class="cursor-pointer text-sm font-semibold text-slate-800">Instructions for common website builders</summary>
                        <div class="mt-3 space-y-3 text-sm text-slate-600">
                            <p><strong class="text-slate-800">WordPress:</strong> On a plugin-enabled site, use a header/footer code tool and paste the snippet into its Footer box. <a class="font-semibold text-sky-700 hover:underline" href="https://wordpress.com/support/adding-code-to-headers/" target="_blank" rel="noopener noreferrer">WordPress guide</a></p>
                            <p><strong class="text-slate-800">Wix:</strong> Open Settings → Custom Code, add the snippet, apply it to all pages, and place it at Body – end. <a class="font-semibold text-sky-700 hover:underline" href="https://support.wix.com/en/article/wix-editor-embedding-custom-code-on-your-site" target="_blank" rel="noopener noreferrer">Wix guide</a></p>
                            <p><strong class="text-slate-800">Squarespace:</strong> Open Code Injection and paste the snippet into the Footer field; code injection availability depends on the site plan. <a class="font-semibold text-sky-700 hover:underline" href="https://support.squarespace.com/hc/en-us/articles/205815908-Using-code-injection" target="_blank" rel="noopener noreferrer">Squarespace guide</a></p>
                            <p><strong class="text-slate-800">Other sites:</strong> Add the snippet to the shared page layout immediately before <code>&lt;/body&gt;</code> so it loads on every page.</p>
                        </div>
                    </details>

                    @if (Model.IsWidgetInstalled && Model.WidgetInstalledAtUtc.HasValue)
                    {
                        <p class="mt-3 text-xs font-semibold text-emerald-700">Last confirmed on @Model.WidgetInstalledDomain at @Model.WidgetInstalledAtUtc.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'").</p>
                    }
                }
            </section>

            <div class="flex justify-end">
                <a href="/owner" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Continue to workspace <i data-lucide="arrow-right" class="h-4 w-4"></i></a>
            </div>
        </main>
    </div>
</div>

@section PageScripts {
    @if (Model.IsEmbeddedSignupAvailable)
    {
        <script>
            (function () {
                "use strict";

                const form = document.getElementById("embeddedSignupForm");
                const button = document.getElementById("connectWhatsAppButton");
                const status = document.getElementById("embeddedSignupStatus");
                if (!form || !button || !status) return;

                let authorizationCode = null;
                let session = null;
                let submitted = false;

                function setStatus(message, isError) {
                    status.textContent = message;
                    status.classList.toggle("text-rose-700", Boolean(isError));
                }

                function isTrustedMetaOrigin(origin) {
                    try {
                        const url = new URL(origin);
                        return url.protocol === "https:" &&
                            (url.hostname === "facebook.com" || url.hostname.endsWith(".facebook.com"));
                    } catch {
                        return false;
                    }
                }

                function submitWhenComplete() {
                    const wabaId = session && session.data && session.data.waba_id;
                    if (submitted || !authorizationCode || !wabaId) return;
                    submitted = true;
                    form.querySelector('[name="authorizationCode"]').value = authorizationCode;
                    form.querySelector('[name="wabaId"]').value = String(wabaId);
                    form.querySelector('[name="phoneNumberId"]').value = session.data.phone_number_id
                        ? String(session.data.phone_number_id)
                        : "";
                    setStatus("Finishing your secure WhatsApp connection…", false);
                    form.submit();
                }

                window.addEventListener("message", function (event) {
                    if (!isTrustedMetaOrigin(event.origin)) return;
                    let payload = event.data;
                    if (typeof payload === "string") {
                        try {
                            payload = JSON.parse(payload);
                        } catch {
                            return;
                        }
                    }
                    if (!payload || payload.type !== "WA_EMBEDDED_SIGNUP") return;

                    if (payload.event === "CANCEL") {
                        button.disabled = false;
                        setStatus("WhatsApp setup was cancelled. You can restart it when ready.", false);
                    } else if (payload.event === "ERROR") {
                        button.disabled = false;
                        setStatus("Meta could not complete WhatsApp setup. Please try again.", true);
                    } else if (payload.data && payload.data.waba_id && !payload.data.current_step) {
                        session = payload;
                        submitWhenComplete();
                    }
                });

                function initializeFacebook() {
                    if (!window.FB) return false;
                    window.FB.init({
                        appId: form.dataset.appId,
                        autoLogAppEvents: false,
                        cookie: false,
                        xfbml: false,
                        version: form.dataset.graphVersion
                    });
                    return true;
                }

                window.fbAsyncInit = initializeFacebook;
                if (window.FB) initializeFacebook();

                button.addEventListener("click", function () {
                    if (!initializeFacebook()) {
                        setStatus("Meta is still loading. Please wait a moment and try again.", true);
                        return;
                    }

                    authorizationCode = null;
                    session = null;
                    submitted = false;
                    button.disabled = true;
                    setStatus("Continue in the secure Meta window…", false);

                    window.FB.login(function (response) {
                        const code = response && response.authResponse && response.authResponse.code;
                        if (!code) {
                            button.disabled = false;
                            setStatus("WhatsApp setup was not authorized. You can try again.", false);
                            return;
                        }
                        authorizationCode = String(code);
                        submitWhenComplete();
                    }, {
                        config_id: form.dataset.configurationId,
                        response_type: "code",
                        override_default_response_type: true,
                        extras: {
                            sessionInfoVersion: "3",
                            version: form.dataset.signupVersion,
                            featureType: "whatsapp_business_app_onboarding"
                        }
                    });
                });
            }());
        </script>
    }
}
