<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WhatsApp Debug</title>
    <style>
        body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; padding: 24px; }
        .row { display: flex; gap: 12px; flex-wrap: wrap; }
        label { display: block; font-weight: 600; margin-bottom: 6px; }
        input, textarea, button { font: inherit; padding: 8px 10px; }
        textarea { width: min(720px, 95vw); height: 120px; }
        .panel { margin-top: 16px; padding: 12px; border: 1px solid #ddd; border-radius: 8px; background: #fafafa; }
        pre { white-space: pre-wrap; }
    </style>
</head>
<body>
<h1>WhatsApp Debug</h1>
<p>Simulate incoming messages without WhatsApp. Uses site_demo configuration.</p>

<div class="row">
    <div>
        <label for="waId">waId (phone number)</label>
        <input id="waId" type="text" value="15551234567" />
    </div>
    <div style="flex:1 1 300px;">
        <label for="message">Message</label>
        <textarea id="message">Hi</textarea>
    </div>
</div>

<p>
    <button id="sendBtn" type="button">Send</button>
</p>

<div class="panel">
    <strong>Reply</strong>
    <pre id="reply"></pre>
</div>
<div class="panel">
    <strong>Collected fields</strong>
    <pre id="collected"></pre>
</div>

<script>
    const btn = document.getElementById("sendBtn");
    const replyEl = document.getElementById("reply");
    const collectedEl = document.getElementById("collected");

    btn.addEventListener("click", async () => {
        const waId = document.getElementById("waId").value.trim();
        const message = document.getElementById("message").value;
        const body = new URLSearchParams({ waId, message });

        const res = await fetch("/debug/whatsapp/send", {
            method: "POST",
            headers: { "content-type": "application/x-www-form-urlencoded" },
            body: body.toString()
        });

        if (!res.ok) {
            replyEl.textContent = "Request failed.";
            collectedEl.textContent = "";
            return;
        }

        const json = await res.json();
        replyEl.textContent = json.reply || "";
        collectedEl.textContent = JSON.stringify(json.collected || {}, null, 2);
    });
</script>
</body>
</html>
