@using LeadRelay.Web.WhatsApp
@inject WhatsAppOnboardingService WhatsAppOnboarding
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Workspace")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/brand/leadrelay-logo-icon.png" />
    <link rel="stylesheet" href="/css/owner.css" asp-append-version="true" />
    <script defer src="/vendor/alpine/alpine.min.js" asp-append-version="true"></script>
    <script defer src="/vendor/lucide/lucide.min.js" asp-append-version="true"></script>
    @RenderSection("HeadScripts", required: false)
</head>
@{
    var ownerAuth = Context.Items.TryGetValue(LeadRelay.Web.Security.OwnerAuthMiddleware.ContextKey, out var authValue)
        ? authValue as LeadRelay.Web.Security.OwnerAuthContext
        : null;
    var whatsappConnection = ownerAuth is null
        ? null
        : await WhatsAppOnboarding.GetSummaryAsync(ownerAuth.SiteId, Context.RequestAborted);
}
<body class="min-h-screen bg-slate-100 text-slate-800">
@if (ownerAuth is not null)
{
    <header class="w-full border-b border-slate-800 bg-slate-900 text-slate-100">
        <div class="h-1 w-full bg-gradient-to-r from-sky-500 via-indigo-500 to-violet-500"></div>
        <div class="flex w-full flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 xl:px-8">
            <div class="flex items-center gap-3">
                <img src="/brand/leadrelay-logo-icon.png"
                     alt="LeadRelay app icon"
                     class="h-10 w-10 rounded-xl object-contain shadow-sm" />
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-300">LeadRelay</p>
                    <p class="text-sm font-semibold text-white">Workspace</p>
                </div>
                <a href="/owner" class="ml-1 inline-flex items-center gap-1 rounded-md border border-slate-700 bg-slate-800 px-3 py-1.5 text-sm font-semibold text-slate-100 transition hover:bg-slate-700">
                    <i data-lucide="inbox" class="h-4 w-4"></i>
                    <span>Leads</span>
                </a>
                <a href="/owner/onboarding" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold @(whatsappConnection?.IsConnected == true && whatsappConnection.IsWebhookVerified ? "bg-emerald-500/20 text-emerald-200" : whatsappConnection?.Exists == true ? "bg-amber-500/20 text-amber-200" : "bg-slate-700 text-slate-200")">
                    <span class="h-2 w-2 rounded-full @(whatsappConnection?.IsConnected == true && whatsappConnection.IsWebhookVerified ? "bg-emerald-400" : whatsappConnection?.Exists == true ? "bg-amber-400" : "bg-slate-400")"></span>
                    @(whatsappConnection?.IsConnected == true && whatsappConnection.IsWebhookVerified ? "WhatsApp verified" : whatsappConnection?.IsConnected == true ? "Verify WhatsApp webhook" : whatsappConnection?.Exists == true ? "WhatsApp action required" : "Set up WhatsApp")
                </a>
            </div>

            <div class="relative" x-data="{ open: false }">
                <button type="button"
                        class="inline-flex items-center gap-1 rounded-md border border-slate-700 bg-slate-800 px-3 py-1.5 text-sm font-semibold text-slate-100 transition hover:bg-slate-700"
                        @@click="open = !open"
                        :aria-expanded="open.toString()">
                    <i data-lucide="user-round" class="h-4 w-4"></i>
                    <span>@ownerAuth.OwnerEmail</span>
                    <i data-lucide="chevron-down" class="h-4 w-4"></i>
                </button>

                <div x-show="open"
                     x-cloak
                     @@click.outside="open = false"
                     class="absolute right-0 z-50 mt-2 w-52 rounded-lg border border-slate-200 bg-white p-1.5 text-slate-800 shadow-lg">
                    <a href="/owner/settings"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
                       @@click="open = false">
                        <i data-lucide="settings-2" class="h-4 w-4"></i>
                        <span>Settings</span>
                    </a>
                    <form method="post" action="/owner/logout" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm font-medium text-rose-700 transition hover:bg-rose-50">
                            <i data-lucide="log-out" class="h-4 w-4"></i>
                            <span>Sign out</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <div id="ownerAjaxProgress" class="pointer-events-none fixed left-0 right-0 top-0 z-[100] h-0.5 origin-left scale-x-0 bg-gradient-to-r from-sky-500 via-indigo-500 to-violet-500 opacity-0 transition-all duration-200"></div>
}
else
{
    <header class="w-full border-b border-slate-200 bg-slate-50/95 backdrop-blur">
        <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
            <a href="/" class="inline-flex items-center gap-2.5 text-slate-900">
                <img src="/brand/leadrelay-logo-icon.png"
                     alt="LeadRelay app icon"
                     class="h-8 w-8 rounded-lg object-contain" />
                <span class="text-sm font-semibold">LeadRelay</span>
            </a>

            <nav class="flex flex-wrap items-center gap-4 text-sm text-slate-600">
                <a href="/#product" class="transition hover:text-slate-900">Product</a>
                <a href="/#how-it-works" class="transition hover:text-slate-900">How it works</a>
                <a href="/#what-you-need" class="transition hover:text-slate-900">What you need</a>
                <a href="/#faq" class="transition hover:text-slate-900">FAQ</a>
            </nav>

            <div class="inline-flex items-center gap-2">
                <a href="/owner/login" class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Sign in</a>
                <a href="/owner/register" class="inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-slate-800">Create account</a>
            </div>
        </div>
    </header>
}
@RenderBody()
@RenderSection("PageScripts", required: false)
<script>
    window.refreshLucideIcons = function () {
        if (window.lucide && typeof window.lucide.createIcons === "function") {
            window.lucide.createIcons();
        }
    };

    document.addEventListener("DOMContentLoaded", function () {
        window.refreshLucideIcons();
    });
</script>
@if (ownerAuth is not null)
{
<script>
    (function () {
        const progress = document.getElementById("ownerAjaxProgress");
        if (!progress) return;

        let pending = 0;

        function showProgress() {
            pending++;
            progress.classList.remove("opacity-0", "scale-x-0");
            progress.classList.add("opacity-100", "scale-x-100");
        }

        function hideProgress() {
            pending = Math.max(0, pending - 1);
            if (pending !== 0) return;
            progress.classList.remove("opacity-100", "scale-x-100");
            progress.classList.add("opacity-0", "scale-x-0");
        }

        function getCurrentPath() {
            return window.location.pathname + window.location.search + window.location.hash;
        }

        async function renderFromResponse(url, options, historyMode) {
            showProgress();
            try {
                const response = await fetch(url, options);
                const html = await response.text();
                const responseUrl = response.url
                    ? new URL(response.url, window.location.origin)
                    : new URL(url, window.location.origin);
                const responsePath = responseUrl.pathname + responseUrl.search + responseUrl.hash;

                if (historyMode === "push" && responsePath !== getCurrentPath()) {
                    history.pushState({}, "", responsePath);
                } else if (historyMode === "replace" && responsePath !== getCurrentPath()) {
                    history.replaceState({}, "", responsePath);
                }

                document.open();
                document.write(html);
                document.close();
            } finally {
                hideProgress();
            }
        }

        document.addEventListener("submit", function (event) {
            const form = event.target;
            if (!(form instanceof HTMLFormElement)) return;
            if (form.dataset.ajax === "off") return;
            if (form.target && form.target !== "_self") return;

            event.preventDefault();

            const method = (form.method || "GET").toUpperCase();
            const formAction = form.getAttribute("action") || window.location.href;
            const url = new URL(formAction, window.location.origin);
            const headers = { "X-Requested-With": "XMLHttpRequest" };
            const options = { method, headers, credentials: "same-origin" };
            let historyMode = null;

            if (method === "GET") {
                const formData = new FormData(form);
                for (const [key, value] of formData.entries()) {
                    url.searchParams.set(key, String(value));
                }
                historyMode = "push";
            } else {
                options.body = new FormData(form);
                historyMode = "replace";
            }

            renderFromResponse(url.toString(), options, historyMode);
        }, true);

        window.addEventListener("popstate", function () {
            renderFromResponse(window.location.href, { method: "GET", credentials: "same-origin", headers: { "X-Requested-With": "XMLHttpRequest" } }, "replace");
        });
    })();
</script>
}
</body>
</html>
