<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "LeadRelay")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f7f9fb;
            --ink: #0f172a;
            --ink-soft: #526077;
            --line: #dbe4f0;
            --panel: #ffffff;
            --brand: #059669;
            --brand-dark: #0f172a;
            --shadow: 0 12px 34px rgba(15, 23, 42, 0.09);
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family: "Inter", "Segoe UI", sans-serif;
            color: var(--ink);
            background: var(--bg);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .marketing-shell {
            width: min(1120px, calc(100% - 32px));
            margin: 0 auto;
        }

        .marketing-nav {
            margin-top: 14px;
            border: 1px solid rgba(15, 23, 42, 0.08);
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 12px 14px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            letter-spacing: 0.1px;
        }

        .logo {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: grid;
            place-items: center;
            color: #fff;
            font-family: "Manrope", sans-serif;
            font-weight: 700;
            background: linear-gradient(145deg, #059669, #0f766e);
        }

        .nav-links {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            color: #334155;
            font-size: 0.95rem;
        }

        .nav-links a:hover { color: #0f172a; }

        .nav-cta {
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid transparent;
            border-radius: 10px;
            padding: 10px 16px;
            font-weight: 600;
            font-size: 0.92rem;
            transition: transform 0.12s ease, filter 0.12s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
            filter: brightness(1.02);
        }

        .btn-secondary {
            border-color: #cbd5e1;
            background: #fff;
            color: #0f172a;
        }

        .btn-primary {
            background: #0f172a;
            color: #fff;
        }

        .marketing-body {
            margin-top: 26px;
        }

        .footer-wrap {
            margin-top: 52px;
            margin-left: calc(50% - 50vw);
            margin-right: calc(50% - 50vw);
            background: #081127;
            color: #d2d9e6;
            border-top: 1px solid rgba(148, 163, 184, 0.25);
        }

        .footer {
            width: min(1120px, calc(100% - 32px));
            margin: 0 auto;
            padding: 34px 0;
            display: grid;
            gap: 22px;
            grid-template-columns: 1.2fr 1fr 1fr 1fr;
        }

        .footer-brand p {
            margin: 10px 0 0;
            color: #9aa8c0;
            font-size: 0.9rem;
            max-width: 34ch;
            line-height: 1.5;
        }

        .footer h3 {
            margin: 0 0 8px;
            font-family: "Manrope", sans-serif;
            color: #f8fafc;
            font-size: 0.9rem;
        }

        .footer-links {
            display: grid;
            gap: 7px;
            font-size: 0.88rem;
        }

        .footer-links a:hover { color: #fff; }

        .footer-bottom {
            width: min(1120px, calc(100% - 32px));
            margin: 0 auto;
            border-top: 1px solid rgba(148, 163, 184, 0.18);
            padding: 12px 0 18px;
            color: #8ea0bd;
            font-size: 0.83rem;
        }

        .doc-wrap {
            width: 100%;
            margin: 0;
        }

        .doc-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 24px;
            box-shadow: var(--shadow);
        }

        .doc-meta {
            color: #64748b;
            margin: 0 0 18px;
        }

        .doc-card h2 {
            margin-top: 24px;
            margin-bottom: 6px;
            font-size: 1.15rem;
            font-family: "Manrope", sans-serif;
        }

        .doc-card p,
        .doc-card li {
            color: #1f2937;
            line-height: 1.62;
        }

        .doc-card ul,
        .doc-card ol {
            padding-left: 20px;
        }

        @@media (max-width: 980px) {
            .marketing-nav {
                gap: 10px;
                align-items: flex-start;
                flex-direction: column;
            }

            .nav-cta { width: 100%; }
            .nav-cta .btn { flex: 1; }
            .footer { grid-template-columns: 1fr 1fr; }
        }

        @@media (max-width: 640px) {
            .marketing-shell,
            .footer,
            .footer-bottom { width: calc(100% - 24px); }
            .doc-card { padding: 18px; }
            .footer { grid-template-columns: 1fr; }
        }
    </style>
    @RenderSection("Head", required: false)
</head>
<body>
<div class="marketing-shell">
    <header class="marketing-nav">
        <a class="brand" href="/">
            <span class="logo">LR</span>
            <span>LeadRelay</span>
        </a>

        <nav class="nav-links">
            <a href="/#product">Product</a>
            <a href="/#how-it-works">How it works</a>
            <a href="/#pricing">Pricing</a>
            <a href="/#faq">FAQ</a>
        </nav>

        <div class="nav-cta">
            <a class="btn btn-secondary" href="/owner/login">Login</a>
            <a class="btn btn-primary" href="/owner/register">Create account</a>
        </div>
    </header>

    <main class="marketing-body">
        @RenderBody()
    </main>
</div>

<footer class="footer-wrap">
    <div class="footer">
        <div class="footer-brand">
            <a class="brand" href="/">
                <span class="logo">LR</span>
                <span>LeadRelay</span>
            </a>
            <p>Drop in WhatsApp click-to-chat, let AI qualify leads, and manage every conversation in one integrated CRM.</p>
        </div>

        <div>
            <h3>Product</h3>
            <nav class="footer-links">
                <a href="/#product">Overview</a>
                <a href="/#how-it-works">How it works</a>
                <a href="/#pricing">Pricing</a>
                <a href="/#faq">FAQ</a>
            </nav>
        </div>

        <div>
            <h3>Account</h3>
            <nav class="footer-links">
                <a href="/owner/register">Create account</a>
                <a href="/owner/login">Login</a>
                <a href="/owner/request-password-reset">Reset password</a>
            </nav>
        </div>

        <div>
            <h3>Legal</h3>
            <nav class="footer-links">
                <a href="/privacy-policy">Privacy policy</a>
                <a href="/terms-and-conditions">Terms and conditions</a>
                <a href="/user-data-deletion">User data deletion</a>
            </nav>
        </div>
    </div>

    <div class="footer-bottom">
        LeadRelay · © @DateTime.UtcNow.Year
    </div>
</footer>
</body>
</html>
