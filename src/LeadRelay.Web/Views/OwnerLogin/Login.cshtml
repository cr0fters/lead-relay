@model LeadRelay.Web.Controllers.OwnerLoginController.OwnerLoginModel
@{
    ViewData["Title"] = "Owner Login";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: #f4f7fb;
            color: #172233;
        }
        .wrap { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
        .card {
            width: 100%;
            max-width: 440px;
            background: #fff;
            border: 1px solid #d3dfef;
            border-radius: 10px;
            padding: 22px;
            box-shadow: 0 8px 24px rgba(20, 38, 65, 0.08);
        }
        h1 { margin: 0 0 10px; font-size: 1.35rem; }
        p { margin: 0 0 14px; color: #4b5d73; }
        label { display: block; font-weight: 600; margin-bottom: 6px; }
        input[type="email"],
        input[type="password"] {
            width: 100%;
            border: 1px solid #b4c3da;
            border-radius: 8px;
            padding: 10px 12px;
            font: inherit;
            box-sizing: border-box;
            margin-bottom: 12px;
        }
        button {
            width: 100%;
            border: none;
            border-radius: 8px;
            padding: 10px 12px;
            background: #0f62fe;
            color: #fff;
            font: inherit;
            font-weight: 600;
            cursor: pointer;
        }
        .error {
            margin-bottom: 12px;
            border: 1px solid #efb4b4;
            background: #fff3f3;
            color: #a02222;
            border-radius: 8px;
            padding: 10px 12px;
        }
    </style>
</head>
<body>
<div class="wrap">
    <main class="card">
        <h1>Owner portal</h1>
        <p>Sign in to view and reply to your leads.</p>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="error">@Model.Error</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Info))
        {
            <div style="margin-bottom:12px;border:1px solid #b7e4c7;background:#f3fff7;color:#1f6c3a;border-radius:8px;padding:10px 12px;">@Model.Info</div>
        }

        <form method="post" action="/owner/login">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <label for="email">Owner email</label>
            <input id="email" name="Email" type="email" required autocomplete="email" value="@Model.Email" />

            <label for="password">Password</label>
            <input id="password" name="Password" type="password" required autocomplete="current-password" />

            <button type="submit">Sign in</button>
        </form>
        <p style="margin-top:12px;"><a href="/owner/password/forgot">Forgot password?</a></p>
    </main>
</div>
</body>
</html>
