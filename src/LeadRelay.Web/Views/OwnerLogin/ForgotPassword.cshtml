@model LeadRelay.Web.Controllers.OwnerLoginController.ForgotPasswordModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password</title>
    <style>
        body { margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:#f4f7fb; color:#172233; }
        .wrap { min-height:100vh; display:grid; place-items:center; padding:24px; }
        .card { width:100%; max-width:440px; background:#fff; border:1px solid #d3dfef; border-radius:10px; padding:22px; box-shadow:0 8px 24px rgba(20,38,65,0.08); }
        input[type="email"] { width:100%; border:1px solid #b4c3da; border-radius:8px; padding:10px 12px; box-sizing:border-box; margin-bottom:12px; }
        label { display:block; font-weight:600; margin-bottom:6px; }
        button { width:100%; border:none; border-radius:8px; padding:10px 12px; background:#0f62fe; color:#fff; font-weight:600; cursor:pointer; }
    </style>
</head>
<body>
<div class="wrap">
    <main class="card">
        <h1>Reset password</h1>
        <p>Enter your owner email to receive reset instructions.</p>
        @if (!string.IsNullOrWhiteSpace(Model.Info))
        {
            <div style="margin-bottom:12px;border:1px solid #b7e4c7;background:#f3fff7;color:#1f6c3a;border-radius:8px;padding:10px 12px;">@Model.Info</div>
        }
        <form method="post" action="/owner/password/forgot">
            @Html.AntiForgeryToken()
            <label for="email">Owner email</label>
            <input id="email" name="Email" type="email" required autocomplete="email" value="@Model.Email" />
            <button type="submit">Send reset link</button>
        </form>
        <p style="margin-top:12px;"><a href="/owner/login">Back to login</a></p>
    </main>
</div>
</body>
</html>
