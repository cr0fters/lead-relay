@model LeadRelay.Web.Controllers.OwnerLoginController.ResetPasswordModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Set New Password</title>
    <style>
        body { margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:#f4f7fb; color:#172233; }
        .wrap { min-height:100vh; display:grid; place-items:center; padding:24px; }
        .card { width:100%; max-width:460px; background:#fff; border:1px solid #d3dfef; border-radius:10px; padding:22px; box-shadow:0 8px 24px rgba(20,38,65,0.08); }
        label { display:block; font-weight:600; margin-bottom:6px; }
        input[type="email"], input[type="password"] { width:100%; border:1px solid #b4c3da; border-radius:8px; padding:10px 12px; box-sizing:border-box; margin-bottom:12px; }
        button { width:100%; border:none; border-radius:8px; padding:10px 12px; background:#0f62fe; color:#fff; font-weight:600; cursor:pointer; }
        .error { margin-bottom:12px; border:1px solid #efb4b4; background:#fff3f3; color:#a02222; border-radius:8px; padding:10px 12px; }
    </style>
</head>
<body>
<div class="wrap">
    <main class="card">
        <h1>Create a new password</h1>
        <p>Use at least 8 characters.</p>
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="error">@Model.Error</div>
        }
        <form method="post" action="/owner/password/reset">
            @Html.AntiForgeryToken()
            <label for="email">Email</label>
            <input id="email" name="Email" type="email" required autocomplete="email" value="@Model.Email" />

            <label for="token">Reset token</label>
            <input id="token" name="Token" type="password" required autocomplete="off" value="@Model.Token" />

            <label for="newPassword">New password</label>
            <input id="newPassword" name="NewPassword" type="password" required autocomplete="new-password" />

            <label for="confirmPassword">Confirm password</label>
            <input id="confirmPassword" name="ConfirmPassword" type="password" required autocomplete="new-password" />

            <button type="submit">Update password</button>
        </form>
        <p style="margin-top:12px;"><a href="/owner/login">Back to login</a></p>
    </main>
</div>
</body>
</html>
