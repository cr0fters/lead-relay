@model LeadRelay.Web.Controllers.OwnerLoginController.VerifyEmailModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verify your email</title>
    <style>
        body { margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:#f4f7fb; color:#172233; }
        .wrap { min-height:100vh; display:grid; place-items:center; padding:24px; }
        .card { width:100%; max-width:460px; background:#fff; border:1px solid #d3dfef; border-radius:10px; padding:22px; box-shadow:0 8px 24px rgba(20,38,65,0.08); }
        button { width:100%; border:none; border-radius:8px; padding:10px 12px; background:#0f62fe; color:#fff; font-weight:600; cursor:pointer; }
        .info { margin-bottom:12px; border:1px solid #b7e4c7; background:#f3fff7; color:#1f6c3a; border-radius:8px; padding:10px 12px; }
        .error { margin-bottom:12px; border:1px solid #efb4b4; background:#fff3f3; color:#a02222; border-radius:8px; padding:10px 12px; }
        .email { font-weight:600; overflow-wrap:anywhere; }
    </style>
</head>
<body>
<div class="wrap">
    <main class="card">
        <h1>Verify your email</h1>
        <p>We sent a verification link to <span class="email">@Model.Email</span>. Verify it before publishing your widget or starting billing.</p>
        @if (!string.IsNullOrWhiteSpace(Model.Info))
        {
            <div class="info" role="status">@Model.Info</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="error" role="alert">@Model.Error</div>
        }
        <p>The link expires. If it has not arrived, check your spam folder or request another one.</p>
        <form method="post" action="/owner/verify-email/resend">
            @Html.AntiForgeryToken()
            <button type="submit">Resend verification email</button>
        </form>
        <form method="post" action="/owner/logout" style="margin-top:12px;">
            @Html.AntiForgeryToken()
            <button type="submit" style="background:#52657f;">Sign out</button>
        </form>
    </main>
</div>
</body>
</html>
