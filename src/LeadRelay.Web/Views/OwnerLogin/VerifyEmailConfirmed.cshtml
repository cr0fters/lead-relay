@model LeadRelay.Web.Controllers.OwnerLoginController.VerifyEmailConfirmedModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Email verification</title>
    <style>
        body { margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:#f4f7fb; color:#172233; }
        .wrap { min-height:100vh; display:grid; place-items:center; padding:24px; }
        .card { width:100%; max-width:460px; background:#fff; border:1px solid #d3dfef; border-radius:10px; padding:22px; box-shadow:0 8px 24px rgba(20,38,65,0.08); }
        .button { display:block; border-radius:8px; padding:10px 12px; background:#0f62fe; color:#fff; font-weight:600; text-align:center; text-decoration:none; }
    </style>
</head>
<body>
<div class="wrap">
    <main class="card">
        @if (Model.Verified)
        {
            <h1>Email verified</h1>
            <p>Your account is ready. Continue to connect WhatsApp and set up your widget.</p>
            <a class="button" href="/owner/onboarding">Continue setup</a>
        }
        else
        {
            <h1>Link unavailable</h1>
            <p>This verification link is invalid, expired, or has already been used. Sign in to request another link.</p>
            <a class="button" href="/owner/login">Sign in</a>
        }
    </main>
</div>
</body>
</html>
