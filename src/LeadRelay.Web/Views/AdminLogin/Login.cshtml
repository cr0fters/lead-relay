@model LeadRelay.Web.Controllers.AdminLoginController.AdminLoginModel
@{
    ViewData["Title"] = "Admin Login";
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { color-scheme: light; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: #f6f8fb;
            color: #18212f;
        }
        .wrap {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
        }
        .card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border: 1px solid #d6deea;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(24, 33, 47, 0.08);
            padding: 24px;
        }
        h1 {
            margin-top: 0;
            margin-bottom: 12px;
            font-size: 1.3rem;
        }
        p {
            margin-top: 0;
            margin-bottom: 16px;
            color: #475466;
        }
        label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
        }
        input[type="password"] {
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #b5c2d6;
            border-radius: 8px;
            padding: 10px 12px;
            font: inherit;
            margin-bottom: 12px;
        }
        button {
            width: 100%;
            border: 0;
            border-radius: 8px;
            background: #1d4ed8;
            color: #fff;
            font: inherit;
            font-weight: 600;
            padding: 10px 14px;
            cursor: pointer;
        }
        .error {
            margin-bottom: 12px;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #f3b3b3;
            background: #fff1f1;
            color: #9b1c1c;
        }
    </style>
</head>
<body>
<div class="wrap">
    <main class="card">
        <h1>Admin Access</h1>
        <p>Enter the admin token to continue.</p>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="error">@Model.Error</div>
        }

        <form method="post" action="/admin/login">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <label for="token">Admin token</label>
            <input id="token" name="Token" type="password" autocomplete="off" required />

            <button type="submit">Sign in</button>
        </form>
    </main>
</div>
</body>
</html>
