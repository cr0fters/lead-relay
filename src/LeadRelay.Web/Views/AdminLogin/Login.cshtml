@model LeadRelay.Web.Controllers.AdminLoginController.AdminLoginModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Admin login";
}

<div class="min-h-screen bg-slate-100 px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-xl rounded-2xl border border-slate-200 bg-white p-6 shadow-panel sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Admin workspace</p>
        <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-slate-900">Admin sign in</h1>
        <p class="mt-3 text-sm text-slate-600">Enter the admin token to manage site configuration and onboarding.</p>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="mt-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@Model.Error</div>
        }

        <form method="post" action="/admin/login" class="mt-5 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div>
                <label class="mb-1.5 block text-sm font-semibold text-slate-700" for="token">Admin token</label>
                <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none ring-slate-200 transition focus:ring" id="token" name="Token" type="password" autocomplete="off" required />
            </div>

            <button class="inline-flex w-full items-center justify-center rounded-lg bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-sky-700" type="submit">Sign in</button>
        </form>
    </div>
</div>
